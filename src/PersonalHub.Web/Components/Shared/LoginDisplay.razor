@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using PersonalHub.Web.Services.Auth

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject AuthService AuthService


<AuthorizeView Context="auth">
    <Authorized>

        @{
            var email =
                auth.User.FindFirst(ClaimTypes.Email)?.Value
                ?? auth.User.FindFirst("email")?.Value
                ?? auth.User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value
                ?? auth.User.Identity?.Name
                ?? "unknown";
        }

        <MudMenu Icon="@Icons.Material.Filled.AccountCircle">

            <MudText Class="px-3 py-2">
                @email
            </MudText>

            <MudDivider />

            <MudMenuItem OnClick="GoToAccount">
                Mon compte
            </MudMenuItem>

            <MudMenuItem OnClick="Logout">
                Déconnexion
            </MudMenuItem>

        </MudMenu>

    </Authorized>

    <NotAuthorized>
        <MudButton Href="/login"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Login">
            Login
        </MudButton>
    </NotAuthorized>
    <NotAuthorized>
        <MudButton Href="/register"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AppRegistration">
            S'inscrire
        </MudButton>
    </NotAuthorized>
</AuthorizeView>


@code {

    private void GoToProfile()
    {
        Navigation.NavigateTo("/account");
    }

    private void GoToAccount()
    {
        Navigation.NavigateTo("/account");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}