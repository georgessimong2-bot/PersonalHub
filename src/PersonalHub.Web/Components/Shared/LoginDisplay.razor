@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Configuration
@using Microsoft.Extensions.Options

@inject IOptions<ApiSettings> ApiSettings
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject UserService UserService


<AuthorizeView Context="auth">
    <Authorized>

        @{
            var email =
                auth.User.FindFirst(ClaimTypes.Email)?.Value
                ?? auth.User.FindFirst("email")?.Value
                ?? auth.User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value
                ?? auth.User.Identity?.Name
                ?? "unknown";
        }

        <MudMenu>

            <ActivatorContent Context="menu">

                <div @onclick="menu.ToggleAsync"
                     style="cursor:pointer">

                    @if (!string.IsNullOrWhiteSpace(_profilePictureUrl))
                    {
                        <MudAvatar Size="Size.Large">
                            <MudImage Src="@GetProfileImageUrl()" />
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Small"
                                   Color="Color.Primary">

                            @GetInitials(email)

                        </MudAvatar>
                    }

                </div>

            </ActivatorContent>

            <ChildContent>

                <MudText Class="px-3 py-2">
                    @email
                </MudText>

                <MudDivider />

                <MudMenuItem OnClick="GoToAccount">
                    Mon compte
                </MudMenuItem>

                <MudMenuItem OnClick="Logout">
                    Déconnexion
                </MudMenuItem>

            </ChildContent>

        </MudMenu>
    </Authorized>

    <NotAuthorized>
        <MudButton Href="/login"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Login">
            Login
        </MudButton>
        <MudButton Href="/register"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AppRegistration">
            Register
        </MudButton>
    </NotAuthorized>
</AuthorizeView>


@code {
    private string? _profilePictureUrl;
    private string ApiBaseUrl =>
       ApiSettings.Value.BaseUrl;
    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        var userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        Console.WriteLine($"USERID = {userId}");

        if (string.IsNullOrWhiteSpace(userId))
            return;

        var userDto =
            await UserService.GetByIdAsync(userId);

        _profilePictureUrl =
            userDto?.ProfilePictureUrl;
    }

    private void GoToAccount()
    {
        Navigation.NavigateTo("/account");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    private string GetInitials(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "?";

        return email[..1].ToUpper();
    }

    private string GetProfileImageUrl()
    {
        if (string.IsNullOrWhiteSpace(_profilePictureUrl))
            return "/images/default-avatar.png";

        return _profilePictureUrl;
    }
}