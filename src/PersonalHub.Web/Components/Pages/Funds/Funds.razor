@page "/funds"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.Funds.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth

@inject FundService FundService
@inject ILogger<Funds> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthService AuthService

<PageTitle>Funds</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"
                                 Size="Size.Large" />
            <MudText Class="mt-4">
                Loading funds...
            </MudText>
        </MudPaper>
    }
    else if (_funds.Count == 0)
    {
        <MudPaper Class="pa-10 text-center rounded-xl">
            <MudText Typo="Typo.h5">
                No funds found
            </MudText>

            <MudText Class="mt-2 mb-6">
                Create your first fund.
            </MudText>

            <a href="/funds/create"
               style="display:inline-block;
                      padding:0.75rem 1.5rem;
                      background:#007bff;
                      color:white;
                      border-radius:4px;
                      text-decoration:none;">
                + Create Fund
            </a>
        </MudPaper>
    }
    else
    {
        <div style="border:1px solid #ddd;border-radius:8px;overflow:hidden;">

            <!-- HEADER -->

            <div style="
                background:#f8f9fa;
                padding:1.5rem;
                border-bottom:2px solid #ddd;
                display:flex;
                justify-content:space-between;
                align-items:center;">

                <div>
                    <h2 style="margin:0;">Funds</h2>

                    <p style="margin:0.5rem 0 0 0;color:#666;">
                        @_filteredFunds.Count fund(s)
                    </p>
                </div>

                <div style="display:flex;gap:0.75rem;">

                    <button @onclick="ExportToExcel"
                            style="
                            padding:0.75rem 1.5rem;
                            background:#28a745;
                            color:white;
                            border:none;
                            border-radius:4px;">
                        📊 Excel
                    </button>

                    <a href="/funds/create"
                       style="
                       padding:0.75rem 1.5rem;
                       background:#007bff;
                       color:white;
                       border-radius:4px;
                       text-decoration:none;">
                        + New Fund
                    </a>

                </div>

            </div>

            <!-- SEARCH -->

            <div style="
                background:white;
                padding:1.5rem;
                border-bottom:1px solid #ddd;">

                <input type="text"
                       placeholder="Search by name, code, country..."
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       style="
                       width:100%;
                       padding:0.75rem;
                       border:1px solid #ddd;
                       border-radius:4px;" />

                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    margin-top:1rem;">

                    <span>
                        Page @_currentPage / @_totalPages
                    </span>

                    <select @onchange="OnPageSizeChanged">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>

                </div>

            </div>

            <!-- TABLE -->

            <table style="width:100%;border-collapse:collapse;">

                <thead style="background:#f0f0f0;">
                    <tr>
                        <th style="padding:1rem;">Fund</th>
                        <th style="padding:1rem;">Type</th>
                        <th style="padding:1rem;">Country</th>
                        <th style="padding:1rem;">Currency</th>
                        <th style="padding:1rem;">Launch Date</th>
                        <th style="padding:1rem;">SubFunds</th>
                        <th style="padding:1rem;">Status</th>
                        <th style="padding:1rem;text-align:center;">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var fund in _paginatedFunds)
                    {
                        <tr style="border-bottom:1px solid #ddd;">

                            <td style="padding:1rem;">

                                <div style="font-weight:bold;">
                                    @fund.Name
                                </div>

                                @if (!string.IsNullOrWhiteSpace(fund.LegalName))
                                {
                                    <div style="
                                        font-size:0.85rem;
                                        color:#666;">
                                        @fund.LegalName
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(fund.FundCode))
                                {
                                    <div style="
                                        font-size:0.8rem;
                                        color:#999;">
                                        @fund.FundCode
                                    </div>
                                }

                            </td>

                            <td style="padding:1rem;">
                                @fund.FundTypeName
                            </td>

                            <td style="padding:1rem;">
                                @(fund.DomicileCountry ?? "-")
                            </td>

                            <td style="padding:1rem;">
                                @(fund.BaseCurrency ?? "-")
                            </td>

                            <td style="padding:1rem;">
                                @(fund.LaunchDate?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td style="padding:1rem;text-align:center;">
                                @fund.SubFundCount
                            </td>

                            <td style="padding:1rem;">

                                @if (fund.IsActive)
                                {
                                    <span style="
                                        color:green;
                                        font-weight:bold;">
                                        ● Active
                                    </span>
                                }
                                else
                                {
                                    <span style="
                                        color:red;
                                        font-weight:bold;">
                                        ● Inactive
                                    </span>
                                }

                            </td>

                            <td style="
                                padding:1rem;
                                text-align:center;">                              

                                <a href="/funds/edit/@fund.Id"
                                   title="Edit">
                                    ✏️
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- PAGINATION -->

            <div style="
                display:flex;
                justify-content:center;
                gap:0.5rem;
                padding:1rem;
                background:#f8f9fa;">

                <button @onclick="PrevPage"
                        disabled="@(_currentPage == 1)">
                    ←
                </button>

                @for (int i = 1; i <= _totalPages; i++)
                {
                    int pageNumber = i;

                    <button @onclick="@(() => GoToPage(pageNumber))"
                            style="@(pageNumber == _currentPage
                                ? "background:#007bff;color:white;"
                                : "")">
                        @pageNumber
                    </button>
                }

                <button @onclick="NextPage"
                        disabled="@(_currentPage >= _totalPages)">
                    →
                </button>

            </div>

        </div>
    }

</MudContainer>

@code {

    private List<FundDto> _funds = [];
    private List<FundDto> _filteredFunds = [];
    private List<FundDto> _paginatedFunds = [];

    private bool _isLoading = true;

    private string _searchTerm = "";

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _funds = await FundService.GetFundsAsync();
            Apply();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Error loading funds");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Apply()
    {
        _filteredFunds =
            string.IsNullOrWhiteSpace(_searchTerm)
            ? _funds
            : _funds.Where(x =>
                x.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                || (x.LegalName ?? "")
                    .Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                || (x.FundCode ?? "")
                    .Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                || (x.DomicileCountry ?? "")
                    .Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                || (x.FundTypeName ?? "")
                    .Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

        _totalPages =
            (int)Math.Ceiling(
                _filteredFunds.Count /
                (double)_pageSize);

        if (_totalPages <= 0)
            _totalPages = 1;

        if (_currentPage > _totalPages)
            _currentPage = 1;

        _paginatedFunds = _filteredFunds
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        _pageSize =
            int.Parse(e.Value?.ToString() ?? "10");

        _currentPage = 1;

        Apply();
    }

    private void PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            Apply();
        }
    }

    private void NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            Apply();
        }
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
        Apply();
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal(
            "PersonalHub");

        using var package = new ExcelPackage();

        var ws =
            package.Workbook.Worksheets.Add("Funds");

        ws.Cells[1, 1].Value = "Name";
        ws.Cells[1, 2].Value = "Legal Name";
        ws.Cells[1, 3].Value = "Fund Code";
        ws.Cells[1, 4].Value = "Type";
        ws.Cells[1, 5].Value = "Country";
        ws.Cells[1, 6].Value = "Currency";
        ws.Cells[1, 7].Value = "Launch Date";
        ws.Cells[1, 8].Value = "SubFunds";
        ws.Cells[1, 9].Value = "Status";

        int row = 2;

        foreach (var fund in _filteredFunds)
        {
            ws.Cells[row, 1].Value = fund.Name;
            ws.Cells[row, 2].Value = fund.LegalName;
            ws.Cells[row, 3].Value = fund.FundCode;
            ws.Cells[row, 4].Value = fund.FundTypeName;
            ws.Cells[row, 5].Value = fund.DomicileCountry;
            ws.Cells[row, 6].Value = fund.BaseCurrency;
            ws.Cells[row, 7].Value = fund.LaunchDate?.ToString("dd/MM/yyyy");
            ws.Cells[row, 8].Value = fund.SubFundCount;
            ws.Cells[row, 9].Value = fund.IsActive ? "Active" : "Inactive";

            row++;
        }

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "Funds.xlsx");
    }
}