@page "/funds"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.Funds.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth

@inject FundService FundService
@inject ILogger<Funds> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthService AuthService

<PageTitle>Funds</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Fund"
               Message="Are you sure you want to delete this fund? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading funds...
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Funds
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_filteredFunds.Count fund(s)
                    </MudText>

                </div>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel">

                        Export Excel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/funds/create"
                               StartIcon="@Icons.Material.Filled.Add">

                        Create Fund

                    </MudButton>

                </MudStack>

            </MudStack>

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="8">

                    <MudTextField T="string"
                                  @bind-Value="SearchTerm"
                                  Label="Search Funds"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">

                        Clear Filters

                    </MudButton>

                </MudItem>

            </MudGrid>

            <MudTable Items="_filteredFunds"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Bordered="true"
                      Elevation="0">

                <HeaderContent>

                    <MudTh>Fund</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Country</MudTh>
                    <MudTh>Currency</MudTh>
                    <MudTh>Launch Date</MudTh>
                    <MudTh>Sub Funds</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Fund">

                        <MudText Typo="Typo.body1">
                            @context.Name
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(context.LegalName))
                        {
                            <MudText Typo="Typo.caption">
                                @context.LegalName
                            </MudText>
                        }

                        @if (!string.IsNullOrWhiteSpace(context.FundCode))
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined">

                                @context.FundCode

                            </MudChip>
                        }

                    </MudTd>

                    <MudTd DataLabel="Type">

                        <MudChip T="string"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined">

                            @context.FundTypeName

                        </MudChip>

                    </MudTd>

                    <MudTd DataLabel="Country">

                        @(context.DomicileCountry ?? "-")

                    </MudTd>

                    <MudTd DataLabel="Currency">

                        @if (!string.IsNullOrWhiteSpace(context.BaseCurrency))
                        {
                            <MudChip T="string"
                                     Size="Size.Small">

                                @context.BaseCurrency

                            </MudChip>
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }

                    </MudTd>

                    <MudTd DataLabel="Launch Date">

                        @if (context.LaunchDate.HasValue)
                        {
                            <MudChip T="string"
                                     Variant="Variant.Outlined">

                                @context.LaunchDate.Value.ToString("yyyy-MM-dd")

                            </MudChip>
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }

                    </MudTd>

                    <MudTd DataLabel="Sub Funds">

                        <MudBadge Content="@context.SubFundCount"
                                  Color="Color.Primary" />

                    </MudTd>

                    <MudTd DataLabel="Status">

                        @if (context.IsActive)
                        {
                            <MudChip T="string"
                                     Color="Color.Success">

                                Active

                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Color="Color.Error">

                                Inactive

                            </MudChip>
                        }

                    </MudTd>

                    <MudTd DataLabel="Actions">

                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Href="@($"/funds/details/{context.Id}")" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Href="@($"/funds/edit/{context.Id}")" />

                        @if (AuthService.GetUserRole() == "ADMIN")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                        }

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {

    private List<FundDto> _funds = [];
    private List<FundDto> _filteredFunds = [];

    private bool _isLoading = true;

    private string _searchTerm = string.Empty;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _fundToDelete = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _funds = await FundService.GetFundsAsync();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error loading funds");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        _filteredFunds =
            string.IsNullOrWhiteSpace(_searchTerm)
            ? _funds
            : _funds.Where(x =>
                x.Name.Contains(
                    _searchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (x.LegalName ?? "")
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ||
                (x.FundCode ?? "")
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ||
                (x.DomicileCountry ?? "")
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ||
                (x.BaseCurrency ?? "")
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                ||
                x.FundTypeName.Contains(
                    _searchTerm,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

        _filteredFunds = _filteredFunds
            .OrderBy(x => x.Name)
            .ToList();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet =
            package.Workbook.Worksheets.Add("Funds");

        worksheet.Cells[1, 1].Value = "Name";
        worksheet.Cells[1, 2].Value = "Legal Name";
        worksheet.Cells[1, 3].Value = "Fund Code";
        worksheet.Cells[1, 4].Value = "Fund Type";
        worksheet.Cells[1, 5].Value = "Country";
        worksheet.Cells[1, 6].Value = "Currency";
        worksheet.Cells[1, 7].Value = "Launch Date";
        worksheet.Cells[1, 8].Value = "Sub Funds";
        worksheet.Cells[1, 9].Value = "Status";

        var row = 2;

        foreach (var fund in _filteredFunds)
        {
            worksheet.Cells[row, 1].Value = fund.Name;
            worksheet.Cells[row, 2].Value = fund.LegalName;
            worksheet.Cells[row, 3].Value = fund.FundCode;
            worksheet.Cells[row, 4].Value = fund.FundTypeName;
            worksheet.Cells[row, 5].Value = fund.DomicileCountry;
            worksheet.Cells[row, 6].Value = fund.BaseCurrency;
            worksheet.Cells[row, 7].Value = fund.LaunchDate?.ToString("yyyy-MM-dd");
            worksheet.Cells[row, 8].Value = fund.SubFundCount;
            worksheet.Cells[row, 9].Value = fund.IsActive ? "Active" : "Inactive";

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "funds.xlsx");
    }

    private async Task ShowDeleteConfirm(Guid id)
    {
        _fundToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_fundToDelete == Guid.Empty)
            return;

        await Delete(_fundToDelete);
        _fundToDelete = Guid.Empty;
    }

    private async Task Delete(Guid id)
    {
        try
        {
            Logger.LogInformation("Deleting fund {Id}", id);

            await FundService.DeleteFundAsync(id);
            _funds.RemoveAll(x => x.Id == id);

            ApplyFilters();

            Logger.LogInformation("Fund {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting fund {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _fundToDelete = Guid.Empty;
        return Task.CompletedTask;
    }
}