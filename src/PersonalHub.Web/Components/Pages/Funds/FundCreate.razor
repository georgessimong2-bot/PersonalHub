@page "/funds/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Funds.CreateFund
@using PersonalHub.Application.Features.FundTypes.Common
@using PersonalHub.Web.Services

@inject ILogger<FundCreate> Logger
@inject NavigationManager Navigation
@inject FundService FundService
@inject FundTypeService FundTypeService

<PageTitle>Create Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    <MudPaper Class="pa-8 rounded-xl">

        <MudText Typo="Typo.h4" Class="mb-6">
            Create Fund
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_error
            </MudAlert>
        }

        <MudTextField @bind-Value="_name"
                      Label="Fund Name"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField @bind-Value="_legalName"
                      Label="Legal Name"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudTextField @bind-Value="_fundCode"
                      Label="Fund Code"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudSelect T="Guid"
                   Label="Fund Type"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   @bind-Value="_fundTypeId"
                   Class="mb-4">

            @foreach (var fundType in _fundTypes)
            {
                <MudSelectItem T="Guid"
                               Value="@fundType.Id">
                    @fundType.Name
                </MudSelectItem>
            }

        </MudSelect>

        <MudTextField @bind-Value="_domicileCountry"
                      Label="Domicile Country"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudTextField @bind-Value="_baseCurrency"
                      Label="Base Currency"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Placeholder="EUR"
                      Class="mb-4" />

        <MudDatePicker Label="Launch Date"
                       Variant="Variant.Outlined"
                       Editable="true"
                       @bind-Date="_launchDate"
                       Class="mb-4" />

        <MudSwitch @bind-Value="_isActive"
                   Label="Active Fund"
                   Color="Color.Success"
                   Class="mb-4" />

        <MudTextField @bind-Value="_description"
                      Label="Description"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Lines="5"
                      Class="mb-6" />

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       OnClick="Cancel">
                Cancel
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleCreateFund"
                       Disabled="_isSubmitting">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />
                    <span class="ml-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create Fund
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {

    private string _name = string.Empty;
    private string? _legalName;
    private string? _fundCode;
    private string? _domicileCountry;
    private string? _baseCurrency;
    private DateTime? _launchDate;
    private bool _isActive = true;
    private string? _description;

    private Guid _fundTypeId;

    private List<FundTypeDto> _fundTypes = [];

    private string _error = string.Empty;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        _fundTypes =
            await FundTypeService.GetFundTypesAsync();
    }

    private async Task HandleCreateFund()
    {
        _error = string.Empty;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Fund Name is required.";
            return;
        }

        if (_fundTypeId == Guid.Empty)
        {
            _error = "Please select a Fund Type.";
            return;
        }

        try
        {
            _isSubmitting = true;

            var command = new CreateFundCommand(
                _name.Trim(),
                _legalName,
                _fundCode,
                _domicileCountry,
                _baseCurrency,
                _launchDate,
                _isActive,
                _description,
                _fundTypeId);

            await FundService.CreateFundAsync(command);

            Navigation.NavigateTo("/funds");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Error creating fund");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/funds");
    }
}