@page "/funds/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Funds.CreateFund
@using PersonalHub.Application.Features.FundTypes.Common
@using PersonalHub.Web.Services

@inject FundService FundService
@inject FundTypeService FundTypeService
@inject NavigationManager Navigation
@inject ILogger<FundCreate> Logger

<PageTitle>Create Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    <MudPaper Class="pa-6">

        <!-- HEADER -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>

                <MudText Typo="Typo.h4">
                    Create Fund
                </MudText>

                <MudText Typo="Typo.body2">
                    Create a new investment fund
                </MudText>

            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">

                New Fund

            </MudChip>

        </MudStack>

        <!-- PREVIEW -->

        <MudPaper Class="pa-4 mb-4"
                  Outlined="true">

            <MudText Typo="Typo.subtitle2">
                Preview
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_name)
                    ? "Unnamed Fund"
                    : _name)

            </MudText>

            @if (!string.IsNullOrWhiteSpace(_legalName))
            {
                <MudText Typo="Typo.body2">
                    @_legalName
                </MudText>
            }

            <MudStack Row="true"
                      Spacing="1"
                      Class="mt-2">

                @if (!string.IsNullOrWhiteSpace(_baseCurrency))
                {
                    <MudChip T="string"
                             Size="Size.Small">

                        @_baseCurrency

                    </MudChip>
                }

                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(_isActive ? Color.Success : Color.Default)">

                    @(_isActive ? "Active" : "Inactive")

                </MudChip>

            </MudStack>

        </MudPaper>

        <!-- FORM -->

        <MudTextField T="string"
                      @bind-Value="_name"
                      Label="Fund Name"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_legalName"
                      Label="Legal Name"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_fundCode"
                      Label="Fund Code"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudSelect T="Guid"
                   Label="Fund Type"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   @bind-Value="_fundTypeId"
                   Class="mb-4">

            @foreach (var fundType in _fundTypes)
            {
                <MudSelectItem T="Guid"
                               Value="@fundType.Id">

                    @fundType.Name

                </MudSelectItem>
            }

        </MudSelect>

        <MudTextField T="string"
                      @bind-Value="_domicileCountry"
                      Label="Domicile Country"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_baseCurrency"
                      Label="Base Currency"
                      Placeholder="EUR"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-4" />

        <MudDatePicker Label="Launch Date"
                       Variant="Variant.Outlined"
                       Editable="true"
                       @bind-Date="_launchDate"
                       Class="mb-4" />

        <MudSwitch @bind-Value="_isActive"
                   Label="Active Fund"
                   Color="Color.Success"
                   Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_description"
                      Label="Description"
                      Variant="Variant.Outlined"
                      Lines="6"
                      FullWidth="true"
                      Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">

                @_error

            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="Cancel">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBusiness"
                       Disabled="_isSubmitting"
                       OnClick="HandleCreateFund">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />

                    <span class="ms-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create Fund
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>
    

</MudContainer>

@code {


private string _name = string.Empty;
    private string? _legalName;
    private string? _fundCode;
    private string? _domicileCountry;
    private string? _baseCurrency;
    private DateTime? _launchDate;
    private bool _isActive = true;
    private string? _description;

    private Guid _fundTypeId;

    private List<FundTypeDto> _fundTypes = [];

    private string? _error;

    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        _fundTypes =
            await FundTypeService.GetFundTypesAsync();
    }

    private async Task HandleCreateFund()
    {
        try
        {
            _error = null;
            _isSubmitting = true;

            if (string.IsNullOrWhiteSpace(_name))
            {
                _error = "Fund name is required.";
                return;
            }

            if (_fundTypeId == Guid.Empty)
            {
                _error = "Please select a fund type.";
                return;
            }

            var command = new CreateFundCommand(
                _name.Trim(),
                _legalName,
                _fundCode,
                _domicileCountry,
                _baseCurrency,
                _launchDate,
                _isActive,
                _description,
                _fundTypeId);

            await FundService.CreateFundAsync(command);

            Navigation.NavigateTo("/funds");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating fund");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/funds");
    }


}
