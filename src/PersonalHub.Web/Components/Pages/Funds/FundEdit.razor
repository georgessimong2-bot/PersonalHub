@page "/funds/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Funds.Common
@using PersonalHub.Application.Features.Funds.UpdateFund
@using PersonalHub.Application.Features.FundTypes.Common
@using PersonalHub.Web.Services

@inject FundService FundService
@inject FundTypeService FundTypeService
@inject NavigationManager Navigation
@inject ILogger<FundEdit> Logger

<PageTitle>Edit Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"
                                 Size="Size.Large" />

            <MudText Class="mt-4">
                Loading fund...
            </MudText>
        </MudPaper>
    }
    else if (_fund is null)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Large"
                     Color="Color.Error" />

            <MudText Typo="Typo.h5" Class="mt-4">
                Fund Not Found
            </MudText>

            <MudText Class="mt-2 mb-6">
                The requested fund does not exist.
            </MudText>

            <MudButton Href="/funds"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Back to Funds
            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6 rounded-xl" Elevation="2">

            <MudText Typo="Typo.h4">
                Edit Fund
            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mb-6">
                Update fund information.
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error"
                          Dense="true"
                          Class="mb-4">
                    @_error
                </MudAlert>
            }

            <!-- FUND NAME -->

            <MudTextField @bind-Value="_name"
                          Label="Fund Name"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          Class="mb-4" />

            <!-- LEGAL NAME -->

            <MudTextField @bind-Value="_legalName"
                          Label="Legal Name"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <!-- FUND CODE -->

            <MudTextField @bind-Value="_fundCode"
                          Label="Fund Code"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <!-- FUND TYPE -->

            <MudSelect T="Guid"
                       Label="Fund Type"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       @bind-Value="_fundTypeId"
                       Class="mb-4">

                @foreach (var fundType in _fundTypes)
                {
                    <MudSelectItem T="Guid"
                                   Value="@fundType.Id">
                        @fundType.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <!-- COUNTRY -->

            <MudTextField @bind-Value="_domicileCountry"
                          Label="Domicile Country"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <!-- CURRENCY -->

            <MudTextField @bind-Value="_baseCurrency"
                          Label="Base Currency"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <!-- LAUNCH DATE -->

            <MudDatePicker Label="Launch Date"
                           Editable="true"
                           Variant="Variant.Outlined"
                           @bind-Date="_launchDate"
                           Class="mb-4" />

            <!-- ACTIVE -->

            <MudSwitch @bind-Value="_isActive"
                       Label="Active Fund"
                       Color="Color.Success"
                       Class="mb-4" />

            <!-- DESCRIPTION -->

            <MudTextField @bind-Value="_description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Lines="5"
                          Class="mb-6" />

            <!-- ACTIONS -->

            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           OnClick="Cancel">
                    Cancel
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleSave"
                           Disabled="_isSubmitting">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />
                        <span class="ml-2">
                            Saving...
                        </span>
                    }
                    else
                    {
                        <span>
                            Save Changes
                        </span>
                    }

                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private FundDto? _fund;

    private List<FundTypeDto> _fundTypes = [];

    private string _name = string.Empty;
    private string? _legalName;
    private string? _fundCode;
    private string? _domicileCountry;
    private string? _baseCurrency;
    private DateTime? _launchDate;
    private bool _isActive = true;
    private string? _description;

    private Guid _fundTypeId;

    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            var fundTask = FundService.GetFundByIdAsync(Id);
            var fundTypesTask = FundTypeService.GetFundTypesAsync();

            await Task.WhenAll(
                fundTask,
                fundTypesTask);

            _fund = fundTask.Result;
            _fundTypes = fundTypesTask.Result;

            if (_fund is not null)
            {
                _name = _fund.Name;
                _legalName = _fund.LegalName;
                _fundCode = _fund.FundCode;
                _domicileCountry = _fund.DomicileCountry;
                _baseCurrency = _fund.BaseCurrency;
                _launchDate = _fund.LaunchDate;
                _isActive = _fund.IsActive;
                _description = _fund.Description;

                _fundTypeId = _fund.FundTypeId;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error loading fund {FundId}",
                Id);

            _error = "Unable to load fund.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSave()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_name))
            {
                _error = "Fund name is required.";
                return;
            }

            if (_fundTypeId == Guid.Empty)
            {
                _error = "Please select a fund type.";
                return;
            }

            var command = new UpdateFundCommand(
                Id,
                _name.Trim(),
                _legalName,
                _fundCode,
                _domicileCountry,
                _baseCurrency,
                _launchDate,
                _isActive,
                _description,
                _fundTypeId);

            var success =
                await FundService.UpdateFundAsync(
                    Id,
                    command);

            if (!success)
            {
                _error = "Unable to update fund.";
                return;
            }

            Navigation.NavigateTo("/funds");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error updating fund {FundId}",
                Id);

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/funds");
    }
}