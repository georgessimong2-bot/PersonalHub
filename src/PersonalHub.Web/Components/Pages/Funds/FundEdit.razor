@page "/funds/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Funds.Common
@using PersonalHub.Application.Features.Funds.UpdateFund
@using PersonalHub.Application.Features.FundTypes.Common
@using PersonalHub.Web.Services

@inject FundService FundService
@inject FundTypeService FundTypeService
@inject NavigationManager Navigation
@inject ILogger<FundEdit> Logger

<PageTitle>Edit Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    
    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading fund...
            </MudText>

        </MudPaper>
    }
    else if (_fund is null)
    {
        <MudPaper Class="pa-8 text-center">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Large"
                     Color="Color.Error" />

            <MudText Typo="Typo.h5"
                     Class="mt-4">

                Fund Not Found

            </MudText>

            <MudText Class="mt-2 mb-6">
                The requested fund could not be found.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="/funds">

                Back to Funds

            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <!-- HEADER -->

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Edit Fund
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Update fund information
                    </MudText>

                </div>

                <MudChip T="string"
                         Color="@(_isActive ? Color.Success : Color.Error)"
                         Variant="Variant.Filled">

                    @(_isActive ? "Active" : "Inactive")

                </MudChip>

            </MudStack>

            <!-- SUMMARY -->

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Fund Type
                        </MudText>

                        <MudText Typo="Typo.h6">
                            @GetSelectedFundTypeName()
                        </MudText>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Currency
                        </MudText>

                        <MudText Typo="Typo.h6">
                            @(_baseCurrency ?? "-")
                        </MudText>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Launch Date
                        </MudText>

                        <MudText Typo="Typo.h6">
                            @(_launchDate?.ToString("yyyy-MM-dd") ?? "-")
                        </MudText>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <!-- FORM -->

            <MudTextField T="string"
                          @bind-Value="_name"
                          Label="Fund Name"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_legalName"
                          Label="Legal Name"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <MudGrid>

                <MudItem xs="12" md="6">

                    <MudTextField T="string"
                                  @bind-Value="_fundCode"
                                  Label="Fund Code"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                </MudItem>

                <MudItem xs="12" md="6">

                    <MudSelect T="Guid"
                               Label="Fund Type"
                               Variant="Variant.Outlined"
                               FullWidth="true"
                               @bind-Value="_fundTypeId">

                        @foreach (var fundType in _fundTypes)
                        {
                            <MudSelectItem T="Guid"
                                           Value="@fundType.Id">

                                @fundType.Name

                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudItem>

            </MudGrid>

            <MudGrid Class="mt-2">

                <MudItem xs="12" md="4">

                    <MudTextField T="string"
                                  @bind-Value="_domicileCountry"
                                  Label="Domicile Country"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudTextField T="string"
                                  @bind-Value="_baseCurrency"
                                  Label="Base Currency"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudDatePicker Label="Launch Date"
                                   Variant="Variant.Outlined"
                                   Editable="true"
                                   @bind-Date="_launchDate" />

                </MudItem>

            </MudGrid>

            <MudPaper Class="pa-4 mt-4"
                      Outlined="true">

                <MudSwitch @bind-Value="_isActive"
                           Color="Color.Success"
                           Label="Fund is active" />

            </MudPaper>

            <MudTextField T="string"
                          @bind-Value="_description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="6"
                          FullWidth="true"
                          Class="mt-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error"
                          Class="mt-4">

                    @_error

                </MudAlert>
            }

            <MudDivider Class="my-4" />

            <!-- ACTIONS -->

            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="Cancel">

                    Cancel

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="_isSubmitting"
                           OnClick="HandleSave">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />

                        <span class="ms-2">
                            Saving...
                        </span>
                    }
                    else
                    {
                        <span>
                            Save Changes
                        </span>
                    }

                </MudButton>

            </MudStack>

        </MudPaper>
    }
    

</MudContainer>

@code {


[Parameter]
    public Guid Id { get; set; }

    private FundDto? _fund;

    private List<FundTypeDto> _fundTypes = [];

    private string _name = string.Empty;
    private string? _legalName;
    private string? _fundCode;
    private string? _domicileCountry;
    private string? _baseCurrency;
    private DateTime? _launchDate;
    private bool _isActive = true;
    private string? _description;

    private Guid _fundTypeId;

    private bool _isLoading = true;
    private bool _isSubmitting;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var fundTask = FundService.GetFundByIdAsync(Id);
            var fundTypesTask = FundTypeService.GetFundTypesAsync();

            await Task.WhenAll(fundTask, fundTypesTask);

            _fund = fundTask.Result;
            _fundTypes = fundTypesTask.Result;

            if (_fund is not null)
            {
                _name = _fund.Name;
                _legalName = _fund.LegalName;
                _fundCode = _fund.FundCode;
                _domicileCountry = _fund.DomicileCountry;
                _baseCurrency = _fund.BaseCurrency;
                _launchDate = _fund.LaunchDate;
                _isActive = _fund.IsActive;
                _description = _fund.Description;
                _fundTypeId = _fund.FundTypeId;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Error loading fund {FundId}",
                Id);

            _error = "Unable to load fund.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSave()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_name))
            {
                _error = "Fund name is required.";
                return;
            }

            if (_fundTypeId == Guid.Empty)
            {
                _error = "Please select a fund type.";
                return;
            }

            var command = new UpdateFundCommand(
                Id,
                _name.Trim(),
                _legalName,
                _fundCode,
                _domicileCountry,
                _baseCurrency,
                _launchDate,
                _isActive,
                _description,
                _fundTypeId);

            var success =
                await FundService.UpdateFundAsync(
                    Id,
                    command);

            if (!success)
            {
                _error = "Unable to update fund.";
                return;
            }

            Navigation.NavigateTo(
                $"/funds/details/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Error updating fund {FundId}",
                Id);

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string GetSelectedFundTypeName()
    {
        return _fundTypes
            .FirstOrDefault(x => x.Id == _fundTypeId)
            ?.Name ?? "-";
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            $"/funds/details/{Id}");
    }


}
