@page "/goals/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Goals.Common
@using PersonalHub.Application.Features.Goals.UpdateGoal
@using PersonalHub.Web.Services

@inject ILogger<GoalEdit> Logger
@inject NavigationManager Navigation
@inject GoalService GoalService

<PageTitle>Edit Goal</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Class="mt-4">Loading goal...</MudText>
        </MudPaper>
    }
    else if (_goal is null)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Style="font-size:64px;width:64px;height:64px;"
                     Color="Color.Error" />

            <MudText Typo="Typo.h5" Class="mt-4">
                Goal Not Found
            </MudText>

            <MudText Class="mt-2 mb-6">
                The goal you're looking for doesn't exist.
            </MudText>

            <MudButton Href="/goals"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Back to Goals
            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6 rounded-xl" Elevation="2">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-6">

                <div>
                    <MudText Typo="Typo.h4">Edit Goal</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Update your goal
                    </MudText>
                </div>

            </MudStack>

            <MudTextField T="string" @bind-Value="_title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <MudTextField T="string" @bind-Value="_description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="4"
                          FullWidth="true"
                          Class="mb-4" />

            <MudNumericField T="decimal"
                             @bind-Value="_targetValue"
                             Label="Target Value"
                             Variant="Variant.Outlined"
                             Class="mb-4" />

            <MudNumericField T="decimal"
                             @bind-Value="_currentValue"
                             Label="Current Value"
                             Variant="Variant.Outlined"
                             Class="mb-4" />

            <MudDatePicker @bind-Date="_deadline"
                           Label="Deadline"
                           Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           OnClick="Cancel">
                    Cancel
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_isSubmitting"
                           OnClick="HandleUpdateGoal">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ml-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }

                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter] public Guid Id { get; set; }

    private GoalDto? _goal;
    private string _title = "";
    private string? _description;
    private decimal _targetValue;
    private decimal _currentValue;
    private DateTime? _deadline;

    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _error;



    protected override async Task OnInitializedAsync()
    {
        await LoadGoal();
    }

    private async Task LoadGoal()
    {
        try
        {
            _goal = await GoalService.GetGoalByIdAsync(Id);

            if (_goal is not null)
            {
                _title = _goal.Title;
                _description = _goal.Description;
                _targetValue = _goal.TargetValue;
                _currentValue = _goal.CurrentValue;
                _deadline = _goal.Deadline;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading goal {Id}", Id);
            _error = "Failed to load goal.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdateGoal()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required";
                return;
            }

            var cmd = new UpdateGoalCommand(
                Id,
                _title.Trim(),
                _description ?? "",
                _targetValue,
                _currentValue,
                _deadline);

            var success = await GoalService.UpdateGoalAsync(Id, cmd);

            if (!success)
            {
                _error = "Failed to update goal";
                return;
            }

            Navigation.NavigateTo("/goals");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating goal {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/goals");
    }
}