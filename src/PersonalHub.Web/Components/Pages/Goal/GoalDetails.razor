@page "/goals/details/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.AI
@using PersonalHub.Application.Features.Goals.Common

@using PersonalHub.Web.Services

@inject GoalService GoalService
@inject NavigationManager Navigation
@inject ILogger<GoalDetails> Logger

<PageTitle>Goal Details</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading goal...</MudText>
        </MudPaper>
    }
    else if (_goal is null)
    {
        <MudPaper Class="pa-8 text-center">
            <MudText Typo="Typo.h5">Goal not found</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <!-- TITLE -->
            <MudText Typo="Typo.h4">
                @_goal.Title
            </MudText>

            <MudText Class="mt-2">
                @_goal.Description
            </MudText>

            <MudDivider Class="my-4" />

            <!-- PROGRESS -->
            <MudText>Current Progress</MudText>

            <MudProgressLinear Value="@GetProgress()"
                               Color="Color.Success"
                               Class="mt-2 mb-2" />

            <MudText>
                @_goal.CurrentValue / @_goal.TargetValue
            </MudText>

            <MudText>
                @_goal.ProgressPercentage.ToString("0")%
            </MudText>

            <MudDivider Class="my-4" />

            <!-- METADATA -->
            <MudText>Status: @_goal.Status</MudText>

            <MudText>
                Deadline: @_goal.Deadline?.ToShortDateString()
            </MudText>

            <MudText>
                Remaining: @(Math.Max(0, _goal.TargetValue - _goal.CurrentValue))
            </MudText>

            @if (_goal.DaysRemaining.HasValue)
            {
                <MudText>
                    Days remaining: @_goal.DaysRemaining
                </MudText>
            }

            <MudDivider Class="my-4" />

            <!-- AI BUTTON -->
            <MudButton Color="Color.Secondary"
                       Variant="Variant.Filled"
                       Disabled="_isGenerating"
                       OnClick="GenerateAdvice">

                Generate AI Advice
            </MudButton>

            @if (_isGenerating)
            {
                <MudProgressCircular Indeterminate="true" Class="mt-3" />
            }

            <!-- AI RESULT STRUCTURED -->
            @if (_advice is not null)
            {
                <MudPaper Class="pa-4 mt-4" Outlined="true">

                    <MudText Typo="Typo.h6">
                        AI Coach
                    </MudText>

                    <!-- SUMMARY -->
                    <MudText Class="mt-2">
                        @_advice.Summary
                    </MudText>

                    <!-- INSIGHTS -->
                    @if (_advice.KeyInsights.Any())
                    {
                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">
                            Key Insights
                        </MudText>

                        <MudList T="string" Dense="true">
                            @foreach (var insight in _advice.KeyInsights)
                            {
                                <MudListItem>@insight</MudListItem>
                            }
                        </MudList>
                    }

                    <!-- ACTIONS -->
                    @if (_advice.Actions.Any())
                    {
                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">
                            Recommended Actions
                        </MudText>

                        <MudList T="string" Dense="true">
                            @foreach (var action in _advice.Actions)
                            {
                                <MudListItem>@action</MudListItem>
                            }
                        </MudList>
                    }

                    <!-- WARNING -->
                    @if (!string.IsNullOrWhiteSpace(_advice.Warning))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @_advice.Warning
                        </MudAlert>
                    }

                    <!-- CONFIDENCE -->
                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.caption">
                        Confidence: @_advice.ConfidenceScore%
                    </MudText>

                    <MudProgressLinear Value="@_advice.ConfidenceScore"
                                       Color="Color.Info"
                                       Class="mt-2" />

                </MudPaper>
            }

            <MudDivider Class="my-4" />

            <!-- ACTIONS -->
            <MudStack Row="true" Spacing="2">

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Href="@($"/goals/edit/{Id}")">

                    Edit
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           OnClick="Back">

                    Back
                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private GoalDto? _goal;

    private bool _isLoading = true;
    private bool _isGenerating;

    private AiGoalAdvice? _advice;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoal();
    }

    private async Task LoadGoal()
    {
        try
        {
            _goal = await GoalService.GetGoalByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private double GetProgress()
        => _goal is null ? 0 : (double)_goal.ProgressPercentage;

    private async Task GenerateAdvice()
    {
        try
        {
            _isGenerating = true;

            _advice = await GoalService.GenerateAdviceAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI generation failed for goal {GoalId}", Id);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/goals");
    }
}