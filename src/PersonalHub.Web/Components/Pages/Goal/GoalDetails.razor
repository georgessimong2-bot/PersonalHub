@page "/goals/details/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.AI
@using PersonalHub.Application.Features.Goals.Common
@using PersonalHub.Web.Services

@inject GoalService GoalService
@inject NavigationManager Navigation
@inject ILogger<GoalDetails> Logger

<PageTitle>Goal Details</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    
    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading goal...
            </MudText>

        </MudPaper>
    }
    else if (_goal is null)
    {
        <MudPaper Class="pa-8 text-center">

            <MudText Typo="Typo.h5">
                Goal not found
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <!-- HEADER -->

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <MudText Typo="Typo.h4">
                    @_goal.Title
                </MudText>

                <MudChip T="string"
                         Color="@GetStatusColor(_goal.Status)"
                         Variant="Variant.Filled">

                    @_goal.Status

                </MudChip>

            </MudStack>

            <!-- DESCRIPTION -->

            <MudPaper Class="pa-4 mt-4"
                      Outlined="true">

                <MudText Typo="Typo.h6">
                    Description
                </MudText>

                <MudText Class="mt-2">
                    @(!string.IsNullOrWhiteSpace(_goal.Description)
                        ? _goal.Description
                        : "No description provided.")
                </MudText>

            </MudPaper>

            <MudDivider Class="my-4" />

            <!-- PROGRESS -->

            <MudText Typo="Typo.h6">
                Progress
            </MudText>

            <MudProgressLinear Value="@GetProgress()"
                               Color="Color.Primary"
                               Rounded="true"
                               Size="Size.Large"
                               Class="mt-2 mb-2" />

            <MudText>

                @_goal.CurrentValue /
                @_goal.TargetValue

                (
                @_goal.ProgressPercentage.ToString("0.0")
                %
                )

            </MudText>

            <!-- KPI CARDS -->

            <MudGrid Class="mt-4">

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-4">

                        <MudText Typo="Typo.caption">
                            Deadline
                        </MudText>

                        <MudText Typo="Typo.h6">

                            @(_goal.Deadline?.ToString("yyyy-MM-dd")
                                ?? "-")

                        </MudText>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-4">

                        <MudText Typo="Typo.caption">
                            Remaining
                        </MudText>

                        <MudText Typo="Typo.h6">

                            @(Math.Max(
                                0,
                                _goal.TargetValue -
                                _goal.CurrentValue))

                        </MudText>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudPaper Class="pa-4">

                        <MudText Typo="Typo.caption">
                            Days Remaining
                        </MudText>

                        <MudText Typo="Typo.h6">

                            @(_goal.DaysRemaining?.ToString()
                                ?? "-")

                        </MudText>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <MudDivider Class="my-4" />

            <!-- AI SECTION -->

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Disabled="_isGenerating"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="GenerateAdvice">

                Generate AI Advice

            </MudButton>

            @if (_isGenerating)
            {
                <MudProgressCircular Indeterminate="true"
                                     Class="mt-4" />
            }

            @if (_advice is not null)
            {
                <MudPaper Class="pa-4 mt-4"
                          Outlined="true">

                    <MudText Typo="Typo.h5">
                        🤖 AI Goal Coach
                    </MudText>

                    <MudText Class="mt-3">
                        @_advice.Summary
                    </MudText>

                    @if (_advice.KeyInsights.Any())
                    {
                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">
                            Key Insights
                        </MudText>

                        <MudList T="string"
                                 Dense="true">

                            @foreach (var insight in _advice.KeyInsights)
                            {
                                <MudListItem>
                                    @insight
                                </MudListItem>
                            }

                        </MudList>
                    }

                    @if (_advice.Actions.Any())
                    {
                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">
                            Recommended Actions
                        </MudText>

                        <MudList T="string"
                                 Dense="true">

                            @foreach (var action in _advice.Actions)
                            {
                                <MudListItem>
                                    @action
                                </MudListItem>
                            }

                        </MudList>
                    }

                    @if (!string.IsNullOrWhiteSpace(_advice.Warning))
                    {
                        <MudAlert Severity="Severity.Warning"
                                  Class="mt-3">

                            @_advice.Warning

                        </MudAlert>
                    }

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.caption">

                        Confidence Score:
                        @_advice.ConfidenceScore%

                    </MudText>

                    <MudProgressLinear Value="@_advice.ConfidenceScore"
                                       Color="Color.Info"
                                       Class="mt-2" />

                </MudPaper>
            }

            <MudDivider Class="my-4" />

            <!-- ACTIONS -->

            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/goals/edit/{Id}")">

                    Edit

                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="Back">

                    Back

                </MudButton>

            </MudStack>

        </MudPaper>
    }
    

</MudContainer>

@code {


[Parameter]
    public Guid Id { get; set; }

    private GoalDto? _goal;

    private bool _isLoading = true;
    private bool _isGenerating;

    private AiGoalAdvice? _advice;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoal();
    }

    private async Task LoadGoal()
    {
        try
        {
            _goal =
                await GoalService.GetGoalByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private double GetProgress()
        => _goal is null
            ? 0
            : (double)_goal.ProgressPercentage;

    private async Task GenerateAdvice()
    {
        try
        {
            _isGenerating = true;

            _advice =
                await GoalService.GenerateAdviceAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "AI generation failed for goal {GoalId}",
                Id);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Completed" => Color.Success,
            "Expired" => Color.Error,
            "Active" => Color.Info,
            _ => Color.Default
        };
    }

    private void Back()
    {
        Navigation.NavigateTo("/goals");
    }


}
