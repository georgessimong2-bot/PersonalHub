@page "/goals/details/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Goals.Common
@using PersonalHub.Web.Services

@inject GoalService GoalService
@inject NavigationManager Navigation
@inject ILogger<GoalDetails> Logger

<PageTitle>Goal Details</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium"
              Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading goal...
            </MudText>

        </MudPaper>
    }
    else if (_goal is null)
    {
        <MudPaper Class="pa-8 text-center">

            <MudText Typo="Typo.h5">
                Goal not found
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudText Typo="Typo.h4">
                @_goal.Title
            </MudText>

            <MudText Class="mt-2">
                @_goal.Description
            </MudText>

            <MudDivider Class="my-4" />

            <MudText>
                Current Progress
            </MudText>

            <MudProgressLinear Value="@GetProgress()"
                               Color="Color.Success"
                               Class="mt-2 mb-2" />

            <MudText>
                @_goal.CurrentValue /
                @_goal.TargetValue
            </MudText>

            <MudText>
                @_goal.ProgressPercentage.ToString("0")%
            </MudText>

            <MudDivider Class="my-4" />

            <MudText>
                Status:
                @_goal.Status
            </MudText>

            <MudText>
                Deadline:
                @_goal.Deadline?.ToShortDateString()
            </MudText>

            <MudText>
                Remaining:
                @(Math.Max(0, _goal.TargetValue - _goal.CurrentValue))
            </MudText>

            @if (_goal.DaysRemaining.HasValue)
            {
                <MudText>
                    Days remaining:
                    @_goal.DaysRemaining
                </MudText>
            }

            <MudDivider Class="my-4" />

            <MudButton Color="Color.Secondary"
                       Variant="Variant.Filled"
                       OnClick="GenerateAdvice">

                Generate AI Advice

            </MudButton>

            @if (_isGenerating)
            {
                <MudProgressCircular Indeterminate="true"
                                     Class="mt-4" />
            }

            @if (!string.IsNullOrWhiteSpace(_advice))
            {
                <MudPaper Class="pa-4 mt-4"
                          Outlined="true">

                    <MudText Typo="Typo.h6">
                        AI Coach
                    </MudText>

                    <MudText Class="mt-2">
                        @_advice
                    </MudText>

                </MudPaper>
            }

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2">

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Href="@($"/goals/edit/{Id}")">

                    Edit

                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           OnClick="Back">

                    Back

                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private GoalDto? _goal;

    private bool _isLoading = true;

    private bool _isGenerating;

    private string? _advice;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoal();
    }

    private async Task LoadGoal()
    {
        try
        {
            _goal =
                await GoalService.GetGoalByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private double GetProgress()
    {
        return _goal is null
            ? 0
            : (double)_goal.ProgressPercentage;
    }

    private async Task GenerateAdvice()
    {
        try
        {
            Console.WriteLine("CALLING AI");

            _advice =
                await GoalService.GenerateAdviceAsync(Id);

            Console.WriteLine("AI RESPONSE = " + _advice);
        }
        catch (Exception ex)
        {
            Console.WriteLine("AI ERROR = " + ex.Message);
            throw;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/goals");
    }
}