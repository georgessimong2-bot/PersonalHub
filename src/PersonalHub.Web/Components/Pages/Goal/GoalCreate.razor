@page "/goals/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Goals.CreateGoal
@using PersonalHub.Web.Services

@inject GoalService GoalService
@inject NavigationManager Navigation
@inject ILogger<GoalCreate> Logger

<PageTitle>Create Goal</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    <MudPaper Class="pa-6">

        <!-- HEADER -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>

                <MudText Typo="Typo.h4">
                    Create Goal
                </MudText>

                <MudText Typo="Typo.body2">
                    Create a new personal goal
                </MudText>

            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">

                New Goal

            </MudChip>

        </MudStack>

        <!-- PREVIEW -->

        <MudPaper Class="pa-4 mb-4"
                  Outlined="true">

            <MudText Typo="Typo.subtitle2">
                Preview
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_title)
                    ? "Untitled Goal"
                    : _title)

            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_description)
                    ? "No description provided."
                    : _description)

            </MudText>

            <MudDivider Class="my-3" />

            <MudText>
                Target Value: @_targetValue
            </MudText>

            @if (_deadline.HasValue)
            {
                <MudText>
                    Deadline: @_deadline.Value.ToString("yyyy-MM-dd")
                </MudText>
            }

        </MudPaper>

        <!-- FORM -->

        <MudTextField T="string"
                      @bind-Value="_title"
                      Label="Title"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_description"
                      Label="Description"
                      Variant="Variant.Outlined"
                      Lines="5"
                      FullWidth="true"
                      Class="mb-4" />

        <MudNumericField T="decimal"
                         @bind-Value="_targetValue"
                         Label="Target Value"
                         Variant="Variant.Outlined"
                         Min="1"
                         FullWidth="true"
                         Class="mb-4" />

        <MudDatePicker Label="Deadline"
                       @bind-Date="_deadline"
                       Variant="Variant.Outlined"
                       Editable="true"
                       Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">

                @_error

            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="Cancel">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Flag"
                       Disabled="_isSubmitting"
                       OnClick="HandleCreateGoal">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />

                    <span class="ms-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create Goal
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>
    

</MudContainer>

@code {


private string _title = string.Empty;

    private string? _description;

    private decimal _targetValue = 1;

    private DateTime? _deadline;

    private string? _error;

    private bool _isSubmitting;

    private async Task HandleCreateGoal()
    {
        try
        {
            _error = null;
            _isSubmitting = true;

            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required.";
                return;
            }

            if (_targetValue <= 0)
            {
                _error = "Target value must be greater than zero.";
                return;
            }

            await GoalService.CreateGoalAsync(
                new CreateGoalCommand(
                    _title.Trim(),
                    _description,
                    _targetValue,
                    _deadline));

            Navigation.NavigateTo("/goals");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating goal");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/goals");
    }


}
