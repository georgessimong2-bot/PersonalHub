@page "/goals/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Goals.CreateGoal
@using PersonalHub.Web.Services

@inject GoalService GoalService
@inject NavigationManager Navigation
@inject ILogger<GoalCreate> Logger

<PageTitle>Create Goal</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">

    <MudPaper Class="pa-8 rounded-xl">

        <MudText Typo="Typo.h4" Class="mb-6">
            Créer un nouvel objectif
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_error
            </MudAlert>
        }

        <form>

            <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-weight:500;margin-bottom:0.5rem;">
                    Titre
                </label>

                <input type="text"
                       @bind="_title"
                       placeholder="Titre de l'objectif"
                       style="width:100%;padding:0.75rem;border:1px solid #ddd;border-radius:4px;" />
            </div>

            <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-weight:500;margin-bottom:0.5rem;">
                    Description
                </label>

                <textarea @bind="_description"
                          rows="5"
                          placeholder="Description de l'objectif"
                          style="width:100%;padding:0.75rem;border:1px solid #ddd;border-radius:4px;"></textarea>
            </div>

            <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-weight:500;margin-bottom:0.5rem;">
                    Valeur cible
                </label>

                <input type="number"
                       step="0.01"
                       @bind="_targetValue"
                       style="width:100%;padding:0.75rem;border:1px solid #ddd;border-radius:4px;" />
            </div>

            <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-weight:500;margin-bottom:0.5rem;">
                    Date limite
                </label>

                <input type="date"
                       @bind="_deadline"
                       style="width:100%;padding:0.75rem;border:1px solid #ddd;border-radius:4px;" />
            </div>

            <div style="display:flex;gap:1rem;">

                <button type="button"
                        @onclick="HandleCreateGoal"
                        disabled="@_isSubmitting"
                        style="padding:0.75rem 2rem;background:#007bff;color:white;border:none;border-radius:4px;font-weight:bold;cursor:pointer;opacity:@(_isSubmitting ? "0.6" : "1");">

                    @if (_isSubmitting)
                    {
                        <span>⏳ Création en cours...</span>
                    }
                    else
                    {
                        <span>✅ Créer l'objectif</span>
                    }

                </button>

                <a href="/goals"
                   style="display:inline-block;padding:0.75rem 2rem;background:#6c757d;color:white;text-decoration:none;border-radius:4px;font-weight:bold;">
                    ❌ Annuler
                </a>

            </div>

        </form>

    </MudPaper>

</MudContainer>

@code {

    private string _title = string.Empty;

    private string? _description;

    private decimal _targetValue = 1;

    private string? _deadlineString;
    private DateTime? _deadline;

    private string _error = string.Empty;

    private bool _isSubmitting;

    private async Task HandleCreateGoal()
    {
        _error = string.Empty;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Le titre est obligatoire.";
            return;
        }

        if (_targetValue <= 0)
        {
            _error = "La valeur cible doit être supérieure à zéro.";
            return;
        }

        _isSubmitting = true;

        try
        {
            DateTime? deadline = null;

            if (!string.IsNullOrWhiteSpace(_deadlineString)
                && DateTime.TryParse(_deadlineString, out var parsedDate))
            {
                deadline = parsedDate;
            }

            await GoalService.CreateGoalAsync(
                new CreateGoalCommand(
                    _title.Trim(),
                    _description,
                    _targetValue,
                    _deadline));

            Navigation.NavigateTo("/goals");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors de la création du goal");
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}