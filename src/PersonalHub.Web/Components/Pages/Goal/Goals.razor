@page "/goals"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Goals.Common
@using PersonalHub.Web.Services
@using OfficeOpenXml
@using PersonalHub.Web.Services.Auth

@inject AuthService AuthService
@inject GoalService GoalService
@inject IJSRuntime JSRuntime
@inject ILogger<Goals> Logger

<PageTitle>Goals</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

@if (_isLoading)
{
    <MudPaper Class="pa-8 text-center rounded-xl">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Class="mt-4">Chargement des goals...</MudText>
    </MudPaper>
}
else if (_filteredGoals.Count == 0 && _goals.Count == 0)
{
    <MudPaper Class="pa-10 text-center rounded-xl">
        <MudText Typo="Typo.h5">Aucun goal</MudText>

        <a href="/goals/create"
           style="display:inline-block;padding:0.75rem 1.5rem;background:#007bff;color:white;border-radius:4px;">
            + Créer un goal
        </a>
    </MudPaper>
}
else
{
<div style="border:1px solid #ddd;border-radius:8px;overflow:hidden;">

    <!-- HEADER -->
    <div style="background:#f8f9fa;padding:1.5rem;border-bottom:2px solid #ddd;display:flex;justify-content:space-between;align-items:center;">
        <div>
            <h2 style="margin:0;">Goals</h2>
            <p style="margin:0.5rem 0 0 0;color:#666;">
                @_filteredGoals.Count goal(s)
            </p>
        </div>

        <div style="display:flex;gap:0.75rem;">
            <button @onclick="ExportToExcel"
                    style="padding:0.75rem 1.5rem;background:#28a745;color:white;border:none;border-radius:4px;">
                📊 Excel
            </button>

            <a href="/goals/create"
               style="padding:0.75rem 1.5rem;background:#007bff;color:white;border-radius:4px;">
                + Create
            </a>
        </div>
    </div>

    <!-- SEARCH -->
    <div style="padding:1.5rem;border-bottom:1px solid #ddd;">
        <input style="width:100%;padding:0.75rem;border:1px solid #ddd;border-radius:4px;"
               placeholder="Search goals..."
               @bind="_searchTerm"
               @bind:event="oninput" />
    </div>

    <!-- TABLE -->
    <table style="width:100%;border-collapse:collapse;">
        <thead style="background:#f0f0f0;">
        <tr>
            <th style="padding:1rem;">Title</th>
            <th style="padding:1rem;">Created By</th>
            <th style="padding:1rem;">Progress</th>
            <th style="padding:1rem;">Status</th>
            <th style="padding:1rem;">Deadline</th>
            <th style="padding:1rem;">Actions</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var g in _paginatedGoals)
        {
            <tr style="border-bottom:1px solid #ddd;">
                <td style="padding:1rem;">@g.Title</td>

                <td style="padding:1rem;">
                    @g.CreatedBy
                </td>

                <td style="padding:1rem;">
                    @g.CurrentValue / @g.TargetValue (@Math.Round(g.ProgressPercentage, 1))%
                </td>

                <td style="padding:1rem;">@g.Status</td>

                <td style="padding:1rem;">
                    @g.Deadline?.ToShortDateString()
                </td>
                    <td style="padding:1rem;">
                        <a href="/goals/details/@g.Id">👁</a>

                        @if (g.UserId == _currentUserId)
                        {
                            <a href="/goals/edit/@g.Id">✏️</a>

                            <button @onclick="() => Delete(g.Id)">
                                🗑
                            </button>
                        }
                    </td>
                </tr>
        }
        </tbody>
    </table>

    <!-- PAGINATION (IDENTIQUE NOTES) -->
    <div style="background:#f8f9fa;padding:1.5rem;border-top:1px solid #ddd;display:flex;justify-content:center;gap:0.5rem;align-items:center;">

        <button @onclick="PreviousPage"
                disabled="@(_currentPage == 1)"
                style="padding:0.5rem 1rem;background:@(_currentPage == 1 ? "#e0e0e0" : "#007bff");color:white;border:none;border-radius:4px;">
            ←
        </button>

        @for (int i = 1; i <= _totalPages && i <= 5; i++)
        {
            int page = i;

            <button @onclick="@(() => GoToPage(page))"
                    style="padding:0.5rem 0.75rem;background:@(_currentPage == page ? "#007bff" : "#f0f0f0");color:@(_currentPage == page ? "white" : "black");border:1px solid #ddd;">
                @i
            </button>
        }

        @if (_totalPages > 5)
        {
            <span>...</span>
        }

        <button @onclick="NextPage"
                disabled="@(_currentPage >= _totalPages)"
                style="padding:0.5rem 1rem;background:@(_currentPage >= _totalPages ? "#e0e0e0" : "#007bff");color:white;border:none;border-radius:4px;">
            →
        </button>

    </div>

</div>
}
</MudContainer>

@code {
    private List<GoalDto> _goals = [];
    private List<GoalDto> _filteredGoals = [];
    private List<GoalDto> _paginatedGoals = [];
    private string? _currentUserId;

    private string _searchTerm = "";

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = AuthService.GetUserId();

        _goals = await GoalService.GetGoalsAsync();

        Apply();

        _isLoading = false;
    }

    private void Apply()
    {
        _filteredGoals = string.IsNullOrWhiteSpace(_searchTerm)
            ? _goals
            : _goals.Where(x =>
                x.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

        _totalPages = (int)Math.Ceiling(_filteredGoals.Count / (double)_pageSize);

        if (_currentPage > _totalPages)
            _currentPage = Math.Max(1, _totalPages);

        _paginatedGoals = _filteredGoals
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void OnSearchChanged(ChangeEventArgs _) { _currentPage = 1; Apply(); }

    private void PreviousPage() { if (_currentPage > 1) _currentPage--; Apply(); }
    private void NextPage() { if (_currentPage < _totalPages) _currentPage++; Apply(); }
    private void GoToPage(int page) { _currentPage = page; Apply(); }

    private async Task Delete(Guid id)
    {
        await GoalService.DeleteGoalAsync(id);
        _goals.RemoveAll(x => x.Id == id);
        Apply();
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("PersonalHub");

        using var package = new ExcelPackage();
        var ws = package.Workbook.Worksheets.Add("Goals");

        ws.Cells[1, 1].Value = "Title";
        ws.Cells[1, 2].Value = "Progress";
        ws.Cells[1, 3].Value = "Status";

        int row = 2;

        foreach (var g in _filteredGoals)
        {
            ws.Cells[row, 1].Value = g.Title;
            ws.Cells[row, 2].Value = g.CreatedBy;
            ws.Cells[row, 3].Value = $"{g.CurrentValue}/{g.TargetValue}";
            ws.Cells[row, 4].Value = g.Status;
            row++;
        }

        var bytes = package.GetAsByteArray();
        await JSRuntime.InvokeVoidAsync("downloadFile", bytes, "goals.xlsx");
    }
}