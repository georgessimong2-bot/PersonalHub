@page "/goals"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.Goals.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth

@inject GoalService GoalService
@inject AuthService AuthService
@inject ILogger<Goals> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Goals</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading goals...
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Goals
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_filteredGoals.Count goal(s)
                    </MudText>

                </div>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel">

                        Export Excel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/goals/create"
                               StartIcon="@Icons.Material.Filled.Add">

                        Create Goal

                    </MudButton>

                </MudStack>

            </MudStack>

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="8">

                    <MudTextField T="string"
                                  @bind-Value="SearchTerm"
                                  Label="Search Goals"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">

                        Clear Filters

                    </MudButton>

                </MudItem>

            </MudGrid>

            <MudTable Items="_filteredGoals"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Bordered="true"
                      Elevation="0">

                <HeaderContent>

                    <MudTh>Title</MudTh>
                    <MudTh>Owner</MudTh>
                    <MudTh>Progress</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Deadline</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Title">

                        <MudTooltip Text="@context.Description">
                            @context.Title
                        </MudTooltip>

                    </MudTd>

                    <MudTd DataLabel="Owner">
                        @context.CreatedBy
                    </MudTd>

                    <MudTd DataLabel="Progress">

                        <MudProgressLinear Value="@((double)context.ProgressPercentage)"
                                           Color="Color.Primary"
                                           Rounded="true" />

                        <MudText Typo="Typo.caption">

                            @context.CurrentValue /
                            @context.TargetValue
                            (
                            @Math.Round(context.ProgressPercentage, 1)
                            %
                            )

                        </MudText>

                    </MudTd>

                    <MudTd DataLabel="Status">

                        <MudChip T="string"
                                 Variant="Variant.Filled"
                                 Color="@GetStatusColor(context.Status)">

                            @context.Status

                        </MudChip>

                    </MudTd>

                    <MudTd DataLabel="Deadline">

                        @if (context.Deadline.HasValue)
                        {
                            <MudChip T="string"
                                     Variant="Variant.Outlined">

                                @context.Deadline.Value.ToString("yyyy-MM-dd")

                            </MudChip>

                            @if (context.DaysRemaining.HasValue)
                            {
                                <MudText Typo="Typo.caption">

                                    @context.DaysRemaining day(s)

                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }

                    </MudTd>

                    <MudTd DataLabel="Actions">

                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Href="@($"/goals/details/{context.Id}")" />

                        @if (context.UserId == _currentUserId)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Href="@($"/goals/edit/{context.Id}")" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="@(() => Delete(context.Id))" />
                        }

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {

    private List<GoalDto> _goals = [];
    private List<GoalDto> _filteredGoals = [];

    private string? _currentUserId;

    private bool _isLoading = true;

    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentUserId = AuthService.GetUserId();

            _goals = await GoalService.GetGoalsAsync();

            ApplyFilters();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        _filteredGoals = string.IsNullOrWhiteSpace(_searchTerm)
            ? _goals
            : _goals.Where(x =>
                x.Title.Contains(
                    _searchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (x.Description ?? string.Empty)
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();

        _filteredGoals = _filteredGoals
            .OrderBy(x => x.Status)
            .ThenBy(x => x.Deadline)
            .ToList();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private async Task Delete(Guid id)
    {
        try
        {
            await GoalService.DeleteGoalAsync(id);

            _goals.RemoveAll(x => x.Id == id);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error deleting goal {GoalId}",
                id);
        }
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet =
            package.Workbook.Worksheets.Add("Goals");

        worksheet.Cells[1, 1].Value = "Title";
        worksheet.Cells[1, 2].Value = "Owner";
        worksheet.Cells[1, 3].Value = "Current Value";
        worksheet.Cells[1, 4].Value = "Target Value";
        worksheet.Cells[1, 5].Value = "Progress %";
        worksheet.Cells[1, 6].Value = "Status";
        worksheet.Cells[1, 7].Value = "Deadline";

        var row = 2;

        foreach (var goal in _filteredGoals)
        {
            worksheet.Cells[row, 1].Value = goal.Title;
            worksheet.Cells[row, 2].Value = goal.CreatedBy;
            worksheet.Cells[row, 3].Value = goal.CurrentValue;
            worksheet.Cells[row, 4].Value = goal.TargetValue;
            worksheet.Cells[row, 5].Value = goal.ProgressPercentage;
            worksheet.Cells[row, 6].Value = goal.Status;
            worksheet.Cells[row, 7].Value =
                goal.Deadline?.ToString("yyyy-MM-dd");

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "goals.xlsx");
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Completed" => Color.Success,
            "Expired" => Color.Error,
            "Active" => Color.Info,
            _ => Color.Default
        };
    }
}