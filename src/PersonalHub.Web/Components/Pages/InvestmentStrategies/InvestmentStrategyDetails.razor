@page "/investmentstrategies/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.InvestmentStrategies.Common
@using PersonalHub.Web.Services

@inject ILogger<InvestmentStrategyDetails> Logger
@inject NavigationManager Navigation
@inject InvestmentStrategyService InvestmentStrategyService

<PageTitle>Investment Strategy Details</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading investment strategy...</MudText>
        </MudPaper>
    }
    else if (_investmentStrategy == null)
    {
        <MudAlert Severity="Severity.Error">Investment Strategy not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">@_investmentStrategy.Name</MudText>
                    <MudText Typo="Typo.body2">Investment Strategy Details</MudText>
                </div>
                <MudChip T="string" Color="@(_investmentStrategy.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled">
                    @(_investmentStrategy.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudStack>

            <MudDivider Class="my-4" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Name</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@_investmentStrategy.Name</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Status</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_investmentStrategy.IsActive ? "Active" : "Inactive")</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2">Description</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_investmentStrategy.Description ?? "No description")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Href="@($"/investmentstrategies/edit/{Id}")">Edit</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="GoBack">Back</MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InvestmentStrategyDto? _investmentStrategy;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvestmentStrategy();
    }

    private async Task LoadInvestmentStrategy()
    {
        try
        {
            _investmentStrategy = await InvestmentStrategyService.GetInvestmentStrategyByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading investment strategy {InvestmentStrategyId}", Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/investmentstrategies");
    }
}
