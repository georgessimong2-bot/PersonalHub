@page "/investmentstrategies"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.InvestmentStrategies.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Components.Shared

@inject InvestmentStrategyService InvestmentStrategyService
@inject ILogger<InvestmentStrategies> Logger
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Investment Strategies</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Investment Strategy"
               Message="Are you sure you want to delete this investment strategy? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading investment strategies...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Investment Strategies</MudText>
                    <MudText Typo="Typo.body2">@_filteredInvestmentStrategies.Count investment strateg(y/ies)</MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel">
                        Export Excel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/investmentstrategies/create" StartIcon="@Icons.Material.Filled.Add">
                        Create Investment Strategy
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="SearchTerm" Label="Search Investment Strategies" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudTable Items="@_filteredInvestmentStrategies" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudTooltip Text="@context.Description">
                            @context.Name
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description.Length > 50 ? context.Description.Substring(0, 50) + "..." : context.Description)</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Href="@($"/investmentstrategies/{context.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Href="@($"/investmentstrategies/edit/{context.Id}")" />
                        <DeleteButtonAdmin OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private List<InvestmentStrategyDto> _investmentStrategies = new();
    private List<InvestmentStrategyDto> _filteredInvestmentStrategies = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _investmentStrategyToDelete = Guid.Empty;

    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            FilterInvestmentStrategies();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInvestmentStrategies();
    }

    private async Task LoadInvestmentStrategies()
    {
        try
        {
            _investmentStrategies = await InvestmentStrategyService.GetInvestmentStrategiesAsync() ?? new List<InvestmentStrategyDto>();
            FilterInvestmentStrategies();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading investment strategies");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterInvestmentStrategies()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredInvestmentStrategies = _investmentStrategies;
        }
        else
        {
            var searchLower = _searchTerm.ToLower();
            _filteredInvestmentStrategies = _investmentStrategies
                .Where(s => s.Name.ToLower().Contains(searchLower) || 
                             (s.Description != null && s.Description.ToLower().Contains(searchLower)))
                .ToList();
        }
    }

    private void ClearFilters()
    {
        SearchTerm = string.Empty;
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet = package.Workbook.Worksheets.Add("Investment Strategies");

        worksheet.Cells[1, 1].Value = "Name";
        worksheet.Cells[1, 2].Value = "Description";
        worksheet.Cells[1, 3].Value = "Status";

        var row = 2;

        foreach (var strategy in _filteredInvestmentStrategies)
        {
            worksheet.Cells[row, 1].Value = strategy.Name;
            worksheet.Cells[row, 2].Value = strategy.Description;
            worksheet.Cells[row, 3].Value = strategy.IsActive ? "Active" : "Inactive";

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "investment_strategies.xlsx");
    }

    private async Task ShowDeleteConfirm(Guid id)
    {
        _investmentStrategyToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_investmentStrategyToDelete == Guid.Empty)
            return;

        await Delete(_investmentStrategyToDelete);
        _investmentStrategyToDelete = Guid.Empty;
    }

    private async Task Delete(Guid id)
    {
        try
        {
            Logger.LogInformation("Deleting investment strategy {Id}", id);

            await InvestmentStrategyService.DeleteInvestmentStrategyAsync(id);
            _investmentStrategies.RemoveAll(x => x.Id == id);

            FilterInvestmentStrategies();

            Logger.LogInformation("Investment strategy {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting investment strategy {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _investmentStrategyToDelete = Guid.Empty;
        return Task.CompletedTask;
    }
}
