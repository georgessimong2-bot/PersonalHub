@page "/benchmarks/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Benchmarks.Common
@using PersonalHub.Application.Features.Benchmarks.UpdateBenchmark
@using PersonalHub.Application.Features.Currency.Common
@using PersonalHub.Web.Services

@inject BenchmarkService BenchmarkService
@inject CurrencyService CurrencyService
@inject NavigationManager Navigation
@inject ILogger<BenchmarkEdit> Logger

<PageTitle>Edit Benchmark</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading benchmark...</MudText>
        </MudPaper>
    }
    else if (_benchmark == null)
    {
        <MudAlert Severity="Severity.Error">Benchmark not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Edit Benchmark</MudText>
                    <MudText Typo="Typo.body2">Update benchmark information</MudText>
                </div>
                <MudChip T="string" Color="@(_isActive ? Color.Success : Color.Error)" Variant="Variant.Filled">
                    @(_isActive ? "Active" : "Inactive")
                </MudChip>
            </MudStack>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.subtitle2">Preview</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_name) ? "Unnamed Benchmark" : _name)
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_provider) ? "No provider specified." : _provider)
                </MudText>
            </MudPaper>

            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_bloombergTicker" Label="Bloomberg Ticker" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_reutersCode" Label="Reuters Code" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_provider" Label="Provider" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />

            <MudSelect T="Guid?" @bind-Value="_currencyId" Label="Currency" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="Guid?" Value="@(null)">None</MudSelectItem>
                @foreach (var currency in _currencies)
                {
                    <MudSelectItem T="Guid?" Value="@currency.Id">@currency.Code - @currency.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="6" FullWidth="true" Class="mb-4" />

            <MudSwitch T="bool" @bind-Checked="_isActive" Label="Active" Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_isSubmitting" OnClick="HandleUpdate">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private BenchmarkDto? _benchmark;
    private string _name = string.Empty;
    private string _bloombergTicker = string.Empty;
    private string _reutersCode = string.Empty;
    private string _provider = string.Empty;
    private Guid? _currencyId = null;
    private string _description = string.Empty;
    private bool _isActive = false;
    private string _error = string.Empty;
    private bool _isSubmitting = false;
    private bool _isLoading = true;
    private List<CurrencyDto> _currencies = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currencies = await CurrencyService.GetCurrenciesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading currencies");
        }

        await LoadBenchmark();
    }

    private async Task LoadBenchmark()
    {
        try
        {
            _benchmark = await BenchmarkService.GetBenchmarkByIdAsync(Id);
            if (_benchmark != null)
            {
                _name = _benchmark.Name;
                _bloombergTicker = _benchmark.BloombergTicker ?? string.Empty;
                _reutersCode = _benchmark.ReutersCode ?? string.Empty;
                _provider = _benchmark.Provider ?? string.Empty;
                _currencyId = _benchmark.CurrencyId;
                _description = _benchmark.Description ?? string.Empty;
                _isActive = _benchmark.IsActive;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading benchmark {BenchmarkId}", Id);
            _error = "An error occurred while loading the benchmark.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _isSubmitting = true;
        _error = string.Empty;

        try
        {
            var command = new UpdateBenchmarkCommand(
                Id,
                _name,
                _bloombergTicker,
                _reutersCode,
                _provider,
                _currencyId,
                _description,
                _isActive
            );

            await BenchmarkService.UpdateBenchmarkAsync(Id, command);
            Navigation.NavigateTo($"/benchmarks/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating benchmark");
            _error = "An error occurred while updating the benchmark.";
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/benchmarks/{Id}");
    }
}
