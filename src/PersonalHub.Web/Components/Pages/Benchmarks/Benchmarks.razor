@page "/benchmarks"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.Benchmarks.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Components.Shared

@inject BenchmarkService BenchmarkService
@inject ILogger<Benchmarks> Logger
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Benchmarks</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Benchmark"
               Message="Are you sure you want to delete this benchmark? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading benchmarks...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Benchmarks</MudText>
                    <MudText Typo="Typo.body2">@_filteredBenchmarks.Count benchmark(s)</MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel">
                        Export Excel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/benchmarks/create" StartIcon="@Icons.Material.Filled.Add">
                        Create Benchmark
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="SearchTerm" Label="Search Benchmarks" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudTable Items="@_filteredBenchmarks" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Provider</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudTooltip Text="@(context.Description ?? "No description")">
                            @context.Name
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Provider">@(context.Provider ?? "-")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Href="@($"/benchmarks/{context.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Href="@($"/benchmarks/edit/{context.Id}")" />
                        <DeleteButtonAdmin OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private List<BenchmarkDto> _benchmarks = new();
    private List<BenchmarkDto> _filteredBenchmarks = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _benchmarkToDelete = Guid.Empty;

    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            FilterBenchmarks();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBenchmarks();
    }

    private async Task LoadBenchmarks()
    {
        try
        {
            _benchmarks = await BenchmarkService.GetBenchmarksAsync() ?? new List<BenchmarkDto>();
            FilterBenchmarks();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading benchmarks");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterBenchmarks()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredBenchmarks = _benchmarks;
        }
        else
        {
            var searchLower = _searchTerm.ToLower();
            _filteredBenchmarks = _benchmarks
                .Where(b => b.Name.ToLower().Contains(searchLower) || 
                            (b.Provider != null && b.Provider.ToLower().Contains(searchLower)) ||
                            (b.Description != null && b.Description.ToLower().Contains(searchLower)))
                .ToList();
        }
    }

    private void ClearFilters()
    {
        SearchTerm = string.Empty;
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet = package.Workbook.Worksheets.Add("Benchmarks");

        worksheet.Cells[1, 1].Value = "Name";
        worksheet.Cells[1, 2].Value = "Provider";
        worksheet.Cells[1, 3].Value = "Status";

        var row = 2;

        foreach (var benchmark in _filteredBenchmarks)
        {
            worksheet.Cells[row, 1].Value = benchmark.Name;
            worksheet.Cells[row, 2].Value = benchmark.Provider;
            worksheet.Cells[row, 3].Value = benchmark.IsActive ? "Active" : "Inactive";

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "benchmarks.xlsx");
    }

    private async Task ShowDeleteConfirm(Guid id)
    {
        _benchmarkToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_benchmarkToDelete == Guid.Empty)
            return;

        await Delete(_benchmarkToDelete);
        _benchmarkToDelete = Guid.Empty;
        _showConfirmDialog = false;

        StateHasChanged();
    }

    private async Task Delete(Guid id)
    {
        try
        {
            Logger.LogInformation("Deleting benchmark {Id}", id);

            await BenchmarkService.DeleteBenchmarkAsync(id);
            _benchmarks.RemoveAll(x => x.Id == id);

            FilterBenchmarks();

            Logger.LogInformation("Benchmark {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting benchmark {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _benchmarkToDelete = Guid.Empty;
        _showConfirmDialog = false;

        StateHasChanged();
        return Task.CompletedTask;
    }
}

