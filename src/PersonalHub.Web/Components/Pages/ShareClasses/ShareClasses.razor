@page "/shareclasses"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.ShareClasses.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Components.Shared

@inject ShareClassService ShareClassService
@inject ILogger<ShareClasses> Logger
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Share Classes</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Share Class"
               Message="Are you sure you want to delete this share class? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading share classes...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Share Classes</MudText>
                    <MudText Typo="Typo.body2">@_filteredShareClasses.Count share class(es)</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/shareclasses/create" StartIcon="@Icons.Material.Filled.Add">
                    Create Share Class
                </MudButton>
            </MudStack>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="SearchTerm" Label="Search Share Classes" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudTable Items="@_filteredShareClasses" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>ISIN</MudTh>
                    <MudTh>Fee</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudTooltip Text="@context.Name">
                            @context.Name
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="ISIN">@(string.IsNullOrWhiteSpace(context.ISIN) ? "-" : context.ISIN)</MudTd>
                    <MudTd DataLabel="Fee">@(context.ManagementFee?.ToString("P") ?? "-")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Href="@($"/shareclasses/{context.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Href="@($"/shareclasses/edit/{context.Id}")" />
                        <DeleteButtonAdmin OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private List<ShareClassDto> _shareClasses = new();
    private List<ShareClassDto> _filteredShareClasses = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _shareClassToDelete = Guid.Empty;

    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            FilterShareClasses();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadShareClasses();
    }

    private async Task LoadShareClasses()
    {
        try
        {
            _shareClasses = await ShareClassService.GetShareClassesAsync() ?? new List<ShareClassDto>();
            FilterShareClasses();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading share classes");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterShareClasses()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredShareClasses = _shareClasses;
        }
        else
        {
            var searchLower = _searchTerm.ToLower();
            _filteredShareClasses = _shareClasses
                .Where(s => s.Name.ToLower().Contains(searchLower) || 
                           (s.ISIN != null && s.ISIN.ToLower().Contains(searchLower)))
                .ToList();
        }
    }

    private void ClearFilters()
    {
        SearchTerm = string.Empty;
    }

    private async Task ShowDeleteConfirm(Guid id)
    {
        _shareClassToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_shareClassToDelete == Guid.Empty)
            return;

        await Delete(_shareClassToDelete);
        _shareClassToDelete = Guid.Empty;
    }

    private async Task Delete(Guid id)
    {
        try
        {
            Logger.LogInformation("Deleting share class {Id}", id);

            await ShareClassService.DeleteShareClassAsync(id);
            _shareClasses.RemoveAll(x => x.Id == id);

            FilterShareClasses();

            Logger.LogInformation("Share class {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting share class {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _shareClassToDelete = Guid.Empty;
        return Task.CompletedTask;
    }
}
}
