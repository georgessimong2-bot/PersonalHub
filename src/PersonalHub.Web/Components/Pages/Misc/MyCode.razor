@page "/mycode"
@using MudBlazor
<h3>MyCode</h3>

<MudContainer>
    <table style="width: 100%; border-collapse: collapse;">
        <thead style="background-color: #f0f0f0; border-bottom: 2px solid #ddd;">
            <tr>
                <th >
                    Page name
                </th>
                <th>
                    Content
                </th>
                
            </tr>
        </thead>
        <tbody>
            @foreach (var file in files)
            {
                <tr style="border-bottom: 1px solid #ddd; hover: background-color: #f9f9f9;">
                    <td style="padding: 1rem; vertical-align: top; font-weight: 500;">
                        @file.Item1
                    </td>
                    <td style="padding: 1rem; vertical-align: top; max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #666;">
                        @file.Item2
                    </td>                   
                </tr>
            }
        </tbody>
    </table>
</MudContainer>

@code {

    private List<Tuple<string, string>> files = new List<Tuple<string, string>>();
    private List<string> listOfUnwantedFolder = new List<string>();
    protected override async Task OnInitializedAsync()
    {
         listOfUnwantedFolder.Add(".vs");
         listOfUnwantedFolder.Add("Logs");
        
        foreach (var file in Directory.GetFiles(@"C:\Users\georg\Documents\GitHub\MyProjects\PersonalHub\", "*.*", new EnumerationOptions() { RecurseSubdirectories = true })
        .Where(i => !listOfUnwantedFolder.Any(f => i.Contains(f))))                
        {
            files.Add(new Tuple<string, string>(file.ToString().Split('\\')[file.ToString().Split('\\').Length - 1], File.ReadAllText(file)));
        }

    }

}
