@page "/subfunds/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.SubFunds.Common
@using PersonalHub.Application.Features.SubFunds.UpdateSubFund
@using PersonalHub.Web.Services

@inject SubFundService SubFundService
@inject NavigationManager Navigation
@inject ILogger<SubFundEdit> Logger

<PageTitle>Edit Sub Fund</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading sub fund...</MudText>
        </MudPaper>
    }
    else if (_subFund == null)
    {
        <MudAlert Severity="Severity.Error">Sub Fund not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Edit Sub Fund</MudText>
                    <MudText Typo="Typo.body2">Update sub fund information</MudText>
                </div>
            </MudStack>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.subtitle2">Preview</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_name) ? "Unnamed Sub Fund" : _name)
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_investmentObjective) ? "No objective provided." : _investmentObjective)
                </MudText>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_internalCode" Label="Internal Code" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_investmentObjective" Label="Investment Objective" Variant="Variant.Outlined" FullWidth="true" Lines="3" Class="mb-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_investmentPolicy" Label="Investment Policy" Variant="Variant.Outlined" FullWidth="true" Lines="3" Class="mb-4" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_geographicFocus" Label="Geographic Focus" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_sectorFocus" Label="Sector Focus" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_riskProfile" Label="Risk Profile" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" FullWidth="true" Lines="6" Class="mb-4" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_isSubmitting" OnClick="HandleUpdate">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SubFundDto? _subFund;
    private string _name = string.Empty;
    private string _internalCode = string.Empty;
    private string _investmentObjective = string.Empty;
    private string _investmentPolicy = string.Empty;
    private string _geographicFocus = string.Empty;
    private string _sectorFocus = string.Empty;
    private string _riskProfile = string.Empty;
    private string _description = string.Empty;
    private string _error = string.Empty;
    private bool _isSubmitting = false;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubFund();
    }

    private async Task LoadSubFund()
    {
        try
        {
            _subFund = await SubFundService.GetSubFundByIdAsync(Id);
            if (_subFund != null)
            {
                _name = _subFund.Name;
                _internalCode = _subFund.InternalCode ?? string.Empty;
                _investmentObjective = _subFund.InvestmentObjective ?? string.Empty;
                _investmentPolicy = _subFund.InvestmentPolicy ?? string.Empty;
                _geographicFocus = _subFund.GeographicFocus ?? string.Empty;
                _sectorFocus = _subFund.SectorFocus ?? string.Empty;
                _riskProfile = _subFund.RiskProfile ?? string.Empty;
                _description = _subFund.Description ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sub fund {SubFundId}", Id);
            _error = "An error occurred while loading the sub fund.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _isSubmitting = true;
        _error = string.Empty;

        try
        {
            var command = new UpdateSubFundCommand(
                Id,
                _name,
                _internalCode,
                _investmentObjective,
                _investmentPolicy,
                _geographicFocus,
                _sectorFocus,
                _riskProfile,
                _description
            );

            await SubFundService.UpdateSubFundAsync(Id, command);
            Navigation.NavigateTo($"/subfunds/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating sub fund");
            _error = "An error occurred while updating the sub fund.";
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/subfunds/{Id}");
    }
}
