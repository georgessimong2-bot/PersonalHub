@page "/subfunds"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.SubFunds.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Components.Shared

@inject SubFundService SubFundService
@inject ILogger<SubFunds> Logger
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Sub Funds</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Sub Fund"
               Message="Are you sure you want to delete this sub fund? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading sub funds...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Sub Funds</MudText>
                    <MudText Typo="Typo.body2">@_filteredSubFunds.Count sub fund(s)</MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel">
                        Export Excel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/subfunds/create" StartIcon="@Icons.Material.Filled.Add">
                        Create Sub Fund
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="SearchTerm" Label="Search Sub Funds" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudTable Items="@_filteredSubFunds" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Internal Code</MudTh>
                    <MudTh>Investment Objective</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudTooltip Text="@context.Name">
                            @context.Name
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Internal Code">@(string.IsNullOrWhiteSpace(context.InternalCode) ? "-" : context.InternalCode)</MudTd>
                    <MudTd DataLabel="Investment Objective">@(string.IsNullOrWhiteSpace(context.InvestmentObjective) ? "-" : context.InvestmentObjective.Length > 40 ? context.InvestmentObjective.Substring(0, 40) + "..." : context.InvestmentObjective)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Href="@($"/subfunds/{context.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Href="@($"/subfunds/edit/{context.Id}")" />
                        @if (AuthService.GetUserRole() == "ADMIN")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private List<SubFundDto> _subFunds = new();
    private List<SubFundDto> _filteredSubFunds = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _subFundToDelete = Guid.Empty;

    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            FilterSubFunds();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSubFunds();
    }

    private async Task LoadSubFunds()
    {
        try
        {
            _subFunds = await SubFundService.GetSubFundsAsync() ?? new List<SubFundDto>();
            FilterSubFunds();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sub funds");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterSubFunds()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredSubFunds = _subFunds;
        }
        else
        {
            var searchLower = _searchTerm.ToLower();
            _filteredSubFunds = _subFunds
                .Where(s => s.Name.ToLower().Contains(searchLower) || 
                           (s.InternalCode != null && s.InternalCode.ToLower().Contains(searchLower)) ||
                           (s.InvestmentObjective != null && s.InvestmentObjective.ToLower().Contains(searchLower)))
                .ToList();
        }
    }

    private void ClearFilters()
    {
        SearchTerm = string.Empty;
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet = package.Workbook.Worksheets.Add("Sub Funds");

        worksheet.Cells[1, 1].Value = "Name";
        worksheet.Cells[1, 2].Value = "Internal Code";
        worksheet.Cells[1, 3].Value = "Investment Objective";

        var row = 2;

        foreach (var subFund in _filteredSubFunds)
        {
            worksheet.Cells[row, 1].Value = subFund.Name;
            worksheet.Cells[row, 2].Value = subFund.InternalCode;
            worksheet.Cells[row, 3].Value = subFund.InvestmentObjective;

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "sub_funds.xlsx");
    }

    private async Task ShowDeleteConfirm(Guid id)
    {
        _subFundToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_subFundToDelete == Guid.Empty)
            return;

        await Delete(_subFundToDelete);
        _subFundToDelete = Guid.Empty;
    }

    private async Task Delete(Guid id)
    {
        try
        {
            Logger.LogInformation("Deleting sub fund {Id}", id);

            await SubFundService.DeleteSubFundAsync(id);
            _subFunds.RemoveAll(x => x.Id == id);

            FilterSubFunds();

            Logger.LogInformation("Sub fund {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting sub fund {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _subFundToDelete = Guid.Empty;
        return Task.CompletedTask;
    }
}
}
