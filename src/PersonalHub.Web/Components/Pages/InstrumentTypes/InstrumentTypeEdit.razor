@page "/instrumenttypes/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.InstrumentTypes.Common
@using PersonalHub.Application.Features.InstrumentTypes.UpdateInstrumentType
@using PersonalHub.Web.Services

@inject InstrumentTypeService InstrumentTypeService
@inject NavigationManager Navigation
@inject ILogger<InstrumentTypeEdit> Logger

<PageTitle>Edit Instrument Type</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading instrument type...</MudText>
        </MudPaper>
    }
    else if (_instrumentType == null)
    {
        <MudAlert Severity="Severity.Error">Instrument Type not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Edit Instrument Type</MudText>
                    <MudText Typo="Typo.body2">Update instrument type information</MudText>
                </div>
                <MudChip T="string" Color="@(_isActive ? Color.Success : Color.Error)" Variant="Variant.Filled">
                    @(_isActive ? "Active" : "Inactive")
                </MudChip>
            </MudStack>

            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" FullWidth="true" Lines="3" Class="mb-4" />

            <MudSwitch T="bool" @bind-Checked="_isActive" Label="Active" Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_isSubmitting" OnClick="HandleUpdate">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InstrumentTypeDto? _instrumentType;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _isActive = false;
    private string _error = string.Empty;
    private bool _isSubmitting = false;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstrumentType();
    }

    private async Task LoadInstrumentType()
    {
        try
        {
            _instrumentType = await InstrumentTypeService.GetInstrumentTypeByIdAsync(Id);
            if (_instrumentType != null)
            {
                _name = _instrumentType.Name;
                _description = _instrumentType.Description ?? string.Empty;
                _isActive = _instrumentType.IsActive;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading instrument type {InstrumentTypeId}", Id);
            _error = "An error occurred while loading the instrument type.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _isSubmitting = true;
        _error = string.Empty;

        try
        {
            var command = new UpdateInstrumentTypeCommand(
                Id,
                _name,
                _description,
                _isActive);

            await InstrumentTypeService.UpdateInstrumentTypeAsync(Id, command);
            Navigation.NavigateTo($"/instrumenttypes/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating instrument type");
            _error = "An error occurred while updating the instrument type.";
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/instrumenttypes/{Id}");
    }
}
