@page "/notes/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Notes.Common
@using PersonalHub.Application.Features.Notes.UpdateNote
@using PersonalHub.Web.Services

@inject ILogger<NoteEdit> Logger
@inject NavigationManager Navigation
@inject NoteService NoteService

<PageTitle>Edit Note</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading note...
            </MudText>

        </MudPaper>
    }
    else if (_note is null)
    {
        <MudPaper Class="pa-8 text-center">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Large"
                     Color="Color.Error" />

            <MudText Typo="Typo.h5"
                     Class="mt-4">

                Note Not Found

            </MudText>

            <MudText Class="mt-2 mb-6">
                The requested note could not be found.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="/notes">

                Back to Notes

            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <!-- HEADER -->

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Edit Note
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Update your note content
                    </MudText>

                </div>

            </MudStack>

            <!-- INFORMATION -->

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Created
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Outlined"
                                 Class="mt-2">

                            @_note.CreatedAt.ToString("yyyy-MM-dd HH:mm")

                        </MudChip>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Last Updated
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined"
                                 Class="mt-2">

                            @(_note.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")
                                ?? "Never")

                        </MudChip>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <!-- FORM -->

            <MudTextField T="string"
                          @bind-Value="_title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_content"
                          Label="Content"
                          Variant="Variant.Outlined"
                          Lines="12"
                          FullWidth="true"
                          Required="true"
                          Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error"
                          Class="mb-4">

                    @_error

                </MudAlert>
            }

            <MudDivider Class="my-4" />

            <!-- ACTIONS -->

            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="Cancel">

                    Cancel

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="_isSubmitting"
                           OnClick="HandleUpdateNote">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />

                        <span class="ms-2">
                            Saving...
                        </span>
                    }
                    else
                    {
                        <span>
                            Save Changes
                        </span>
                    }

                </MudButton>

            </MudStack>

        </MudPaper>
    }
    

</MudContainer>

@code {


[Parameter]
    public Guid Id { get; set; }

    private NoteDto? _note;

    private string _title = string.Empty;
    private string _content = string.Empty;

    private bool _isLoading = true;
    private bool _isSubmitting;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadNote();
    }

    private async Task LoadNote()
    {
        try
        {
            _note = await NoteService.GetNoteByIdAsync(Id);

            if (_note is not null)
            {
                _title = _note.Title;
                _content = _note.Content;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error loading note {NoteId}",
                Id);

            _error = "Failed to load note.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdateNote()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_content))
            {
                _error = "Content is required.";
                return;
            }

            var command = new UpdateNoteCommand(
                Id,
                _title.Trim(),
                _content.Trim());

            await NoteService.UpdateNoteAsync(Id, command);
            Navigation.NavigateTo($"/notes/details/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error updating note {NoteId}",
                Id);

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            $"/notes/details/{Id}");
    }


}
