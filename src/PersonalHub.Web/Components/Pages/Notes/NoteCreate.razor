@page "/notes/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Web.Services
@using PersonalHub.Application.Features.Notes.CreateNote

@inject NoteService NoteService
@inject NavigationManager Navigation
@inject ILogger<NoteCreate> Logger

<PageTitle>Create Note</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    <MudPaper Class="pa-6">

        <!-- HEADER -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>

                <MudText Typo="Typo.h4">
                    Create Note
                </MudText>

                <MudText Typo="Typo.body2">
                    Create a new note
                </MudText>

            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">

                New Note

            </MudChip>

        </MudStack>

        <!-- PREVIEW -->

        <MudPaper Class="pa-4 mb-4"
                  Outlined="true">

            <MudText Typo="Typo.subtitle2">
                Preview
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_title)
                    ? "Untitled Note"
                    : _title)

            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_content)
                    ? "No content yet..."
                    : (_content.Length > 200
                        ? _content[..200] + "..."
                        : _content))

            </MudText>

        </MudPaper>

        <!-- FORM -->

        <MudTextField T="string"
                      @bind-Value="_title"
                      Label="Title"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_content"
                      Label="Content"
                      Variant="Variant.Outlined"
                      Lines="10"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">

                @_error

            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="Cancel">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.NoteAdd"
                       Disabled="_isSubmitting"
                       OnClick="HandleCreateNote">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />

                    <span class="ms-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create Note
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>
    

</MudContainer>

@code {


private string _title = string.Empty;

    private string _content = string.Empty;

    private string? _error;

    private bool _isSubmitting;

    private async Task HandleCreateNote()
    {
        try
        {
            _error = null;
            _isSubmitting = true;

            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_content))
            {
                _error = "Content is required.";
                return;
            }

            var command = new CreateNoteCommand(
                _title.Trim(),
                _content.Trim());

            await NoteService.CreateNoteAsync(command);
            Navigation.NavigateTo("/notes");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating note");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/notes");
    }


}
