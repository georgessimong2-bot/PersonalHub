@page "/notes/create"
@rendermode InteractiveServer

@using MudBlazor
@using Microsoft.Extensions.Options
@using PersonalHub.Web.Configuration
@using PersonalHub.Application.Features.Notes.CreateNote

@inject HttpClient Http
@inject IOptions<ApiSettings> ApiSettings
@inject ILogger<Create> Logger
@inject NavigationManager Navigation

<PageTitle>Create Note</PageTitle>

<div style="max-width: 600px; margin: 2rem auto; padding: 1.5rem; border: 1px solid #ccc; border-radius: 8px;">

    <h2>Create Note</h2>
    <p>Add a new note to your collection</p>

    <div style="margin-bottom: 1rem;">
        <label for="title">Title:</label><br />
        <input type="text" id="title" @bind="_title" style="width: 100%; padding: 0.5rem; font-size: 1rem;" />
    </div>

    <div style="margin-bottom: 1rem;">
        <label for="content">Content:</label><br />
        <textarea id="content" @bind="_content" rows="6" style="width: 100%; padding: 0.5rem; font-size: 1rem;"></textarea>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div style="padding: 1rem; margin-bottom: 1rem; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 4px;">
            @_error
        </div>
    }

    <div style="text-align: right;">
        <button type="button" @onclick="Cancel" style="padding: 0.5rem 1rem; margin-right: 0.5rem; cursor: pointer;">
            Cancel
        </button>

        <button type="button" @onclick="@(async () => await HandleCreateNote())" disabled="@_isSubmitting" style="padding: 0.5rem 1rem; cursor: pointer; background-color: #007bff; color: white; border: none; border-radius: 4px;">
            @if (_isSubmitting)
            {
                <span>Creating...</span>
            }
            else
            {
                <span>Create Note</span>
            }
        </button>
    </div>

</div>

@code {

    private string _title = string.Empty;
    private string _content = string.Empty;
    private bool _isSubmitting = false;
    private string? _error;

    private string ApiUrl =>
        ApiSettings.Value.BaseUrl;

    private async Task HandleCreateNote()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            Logger.LogInformation(
                "Creating note with title: '{Title}', content length: {ContentLength}",
                _title,
                _content?.Length ?? 0);

            // Validation manuelle
            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required";
                _isSubmitting = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(_content))
            {
                _error = "Content is required";
                _isSubmitting = false;
                return;
            }

            var command = new CreateNoteCommand(_title.Trim(), _content.Trim());

            Logger.LogInformation(
                "Sending command to API: Title='{Title}', ContentLength={Length}",
                command.Title,
                command.Content.Length);

            var response =
                await Http.PostAsJsonAsync(
                    $"{ApiUrl}/api/notes",
                    command);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError(
                    "API Error {StatusCode}: {ErrorContent}",
                    response.StatusCode,
                    errorContent);

                _error = $"Failed to create note: {response.StatusCode} - {errorContent}";
                return;
            }

            Logger.LogInformation("Note created successfully");

            Navigation.NavigateTo("/index");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(
                ex,
                "Error creating note");

            _error = $"Failed to create note: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Unexpected error creating note");

            _error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/index");
    }
}