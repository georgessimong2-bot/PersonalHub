@page "/notes/create"
@rendermode InteractiveServer

@using MudBlazor
@using Microsoft.Extensions.Options
@using PersonalHub.Application.Features.Notes.CreateNote
@using PersonalHub.Web.Configuration
@using PersonalHub.Web.Services

@inject ILogger<Create> Logger
@inject NavigationManager Navigation
@inject NotesService NotesService

<PageTitle>Create Note</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8 rounded-xl">
        <MudText Typo="Typo.h4" Class="mb-6">
            Créer une nouvelle note
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_error
                <MudIconButton Icon="@Icons.Material.Filled.Close" 
                               Size="Size.Small" 
                               OnClick="@(() => _error = string.Empty)" />
            </MudAlert>
        }

        <form>
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Titre</label>
                <input type="text"
                       @bind="_title"
                       placeholder="Entrez le titre de la note"
                       style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem;" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Contenu</label>
                <textarea @bind="_content"
                          placeholder="Entrez le contenu de la note"
                          rows="8"
                          style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; font-family: monospace;"></textarea>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="button"
                        @onclick="HandleCreateNote"
                        disabled="@_isSubmitting"
                        style="padding: 0.75rem 2rem; background-color: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: @(_isSubmitting ? "not-allowed" : "pointer"); opacity: @(_isSubmitting ? "0.6" : "1");">
                    @if (_isSubmitting)
                    {
                        <span>⏳ Création en cours...</span>
                    }
                    else
                    {
                        <span>✅ Créer la note</span>
                    }
                </button>

                <a href="/index"
                   style="display: inline-block; padding: 0.75rem 2rem; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
                    ❌ Annuler
                </a>
            </div>
        </form>
    </MudPaper>
</MudContainer>

@code {
    private string _title = string.Empty;

    private string _content = string.Empty;

    private string _error = string.Empty;

    private bool _isSubmitting = false;

    private async Task HandleCreateNote()
    {
        _error = string.Empty;

        // Validation
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Le titre est obligatoire.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_content))
        {
            _error = "Le contenu est obligatoire.";
            return;
        }

        _isSubmitting = true;

        try
        {
            Logger.LogInformation("Création d'une nouvelle note: Title={Title}", _title);

            var success = await NotesService.CreateAsync(_title, _content);

            if (!success)
            {
                Logger.LogError("Erreur lors de la création de la note");
                _error = "Erreur lors de la création de la note";
                return;
            }

            Logger.LogInformation("Note créée avec succès");
            Navigation.NavigateTo("/index");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors de la création de la note");
            _error = $"Une erreur est survenue: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
