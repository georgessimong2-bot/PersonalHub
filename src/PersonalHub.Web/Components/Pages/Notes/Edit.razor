@page "/notes/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using Microsoft.Extensions.Options
@using PersonalHub.Web.Configuration
@using PersonalHub.Application.Features.Notes.Common
@using PersonalHub.Application.Features.Notes.UpdateNote
@using PersonalHub.Web.Services

@inject ILogger<Edit> Logger
@inject NavigationManager Navigation
@inject NotesService NotesService

<PageTitle>Edit Note</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">

            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"
                                 Size="Size.Large" />

            <MudText Class="mt-4">
                Loading note...
            </MudText>

        </MudPaper>
    }
    else if (_note is null)
    {
        <MudPaper Class="pa-8 text-center rounded-xl">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Style="font-size: 64px; width:64px; height:64px;"
                     Color="Color.Error" />

            <MudText Typo="Typo.h5" Class="mt-4">
                Note Not Found
            </MudText>

            <MudText Class="mt-2 mb-6">
                The note you're looking for doesn't exist.
            </MudText>

            <MudButton Href="/notes"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Back to Notes
            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6 rounded-xl" Elevation="2">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-6">

                <div>
                    <MudText Typo="Typo.h4">
                        Edit Note
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">
                        Update your note
                    </MudText>
                </div>

            </MudStack>

            <MudTextField @bind-Value="_title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <MudTextField @bind-Value="_content"
                          Label="Content"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Lines="6"
                          Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="@(async () => await HandleUpdateNote())"
                           Disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ml-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private string _title = string.Empty;
    private string _content = string.Empty;
    private NoteDto? _note;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadNote();
    }

    private async Task LoadNote()
    {
        try
        {
            _isLoading = true;

            Logger.LogInformation(
                "Loading note {Id}",
                Id);

            _note =
                await NotesService.GetNoteAsync(Id);

            if (_note is not null)
            {
                _title = _note.Title;
                _content = _note.Content;

                Logger.LogInformation(
                    "Note {Id} loaded",
                    Id);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(
                ex,
                "Error loading note {Id}",
                Id);

            _error = "Failed to load note.";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Unexpected error loading note {Id}",
                Id);

            _error = "An unexpected error occurred.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdateNote()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            Logger.LogInformation(
                "Updating note {Id}",
                Id);

            // Validation manuelle
            if (string.IsNullOrWhiteSpace(_title))
            {
                _error = "Title is required";
                _isSubmitting = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(_content))
            {
                _error = "Content is required";
                _isSubmitting = false;
                return;
            }

            var trimmedTitle = _title.Trim();
            var trimmedContent = _content.Trim();

            Logger.LogInformation(
                "Sending update to service: Title='{Title}'",
                trimmedTitle);

            var success = await NotesService.UpdateAsync(Id, trimmedTitle, trimmedContent);

            if (!success)
            {
                Logger.LogError(
                    "Failed to update note {Id}",
                    Id);

                _error = "Failed to update note";
                return;
            }

            Logger.LogInformation(
                "Note {Id} updated successfully",
                Id);

            Navigation.NavigateTo("/notes");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(
                ex,
                "Error updating note {Id}",
                Id);

            _error = $"Failed to update note: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Unexpected error updating note {Id}",
                Id);

            _error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/index");
    }
}