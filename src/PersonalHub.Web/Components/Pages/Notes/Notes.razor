@page "/notes"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.Notes.Common

@inject NotesService NotesService
@inject ILogger<Notes> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Notes</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Note"
               Message="Are you sure you want to delete this note? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading notes...
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Notes
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_filteredNotes.Count note(s)
                    </MudText>

                </div>

                <MudStack Row="true" Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel">

                        Export Excel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/notes/create"
                               StartIcon="@Icons.Material.Filled.Add">

                        Create Note

                    </MudButton>

                </MudStack>

            </MudStack>

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="6">

                    <MudTextField T="string"
                                  @bind-Value="SearchTerm"
                                  Label="Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />

                </MudItem>

                <MudItem xs="12" md="3">

                    <MudDatePicker Label="From"
                                   Date="_searchDateFrom"
                                   DateChanged="DateFromChanged" />

                </MudItem>

                <MudItem xs="12" md="3">

                    <MudDatePicker Label="To"
                                   Date="_searchDateTo"
                                   DateChanged="DateToChanged" />                   

                </MudItem>

                <MudItem xs="12">

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">

                        Clear Filters

                    </MudButton>

                </MudItem>


                

            </MudGrid>

            <MudTable Items="_filteredNotes"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Bordered="true"
                      Elevation="0">

                <HeaderContent>

                    <MudTh>Title</MudTh>
                    <MudTh>Content</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Updated</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Title">
                        @context.Title
                    </MudTd>

                    <MudTd DataLabel="Content">

                        <MudTooltip Text="@context.Content">

                            @(string.IsNullOrWhiteSpace(context.Content)
                                ? "-"
                                : context.Content.Length > 100
                                    ? context.Content[..100] + "..."
                                    : context.Content)

                        </MudTooltip>

                    </MudTd>

                    <MudTd DataLabel="Created">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined">

                            @context.CreatedAt.ToString("yyyy-MM-dd")

                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Updated">

                        @if (context.UpdatedAt.HasValue)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined">

                                @context.UpdatedAt.Value.ToString("yyyy-MM-dd")

                            </MudChip>
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }

                    </MudTd>

                    <MudTd DataLabel="Actions">

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Href="@($"/notes/edit/{context.Id}")" />

                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Href="@($"/notes/details/{context.Id}")" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => ShowDeleteConfirm(context.Id))" />

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }

</MudContainer>
@code {
    private ConfirmDialog? _confirmDialog;

    private bool _showConfirmDialog;

    private Guid _noteToDelete;

    private bool _isLoading = true;

    private List<NoteDto> _notes = [];
    private List<NoteDto> _filteredNotes = [];

    private string _searchTerm = string.Empty;

    private DateTime? _searchDateFrom;
    private DateTime? _searchDateTo;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotes();
    }

    private async Task LoadNotes()
    {
        try
        {
            _notes = await NotesService.GetNotesAsync() ?? [];
            ApplyFilters();
        }
        finally
        {
            _isLoading = false;
        }
    }



    private void DateFromChanged(DateTime? value)
    {
        _searchDateFrom = value;
        ApplyFilters();
    }

    private void DateToChanged(DateTime? value)
    {
        _searchDateTo = value;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredNotes = _notes;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredNotes = _filteredNotes
                .Where(x =>
                    x.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                    ||
                    x.Content.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (_searchDateFrom.HasValue)
        {
            _filteredNotes = _filteredNotes
                .Where(x => x.CreatedAt.Date >= _searchDateFrom.Value.Date)
                .ToList();
        }

        if (_searchDateTo.HasValue)
        {
            _filteredNotes = _filteredNotes
                .Where(x => x.CreatedAt.Date <= _searchDateTo.Value.Date)
                .ToList();
        }

        _filteredNotes = _filteredNotes
            .OrderByDescending(x => x.CreatedAt)
            .ToList();
    }

    private void ShowDeleteConfirm(Guid id)
    {
        _noteToDelete = id;
        _showConfirmDialog = true;
    }

    private async Task ConfirmDelete()
    {
        if (_noteToDelete == Guid.Empty)
            return;

        var success = await NotesService.DeleteAsync(_noteToDelete);

        if (success)
        {
            _notes.RemoveAll(x => x.Id == _noteToDelete);
            ApplyFilters();
        }

        _noteToDelete = Guid.Empty;
        _showConfirmDialog = false;
    }

    private Task CancelDelete()
    {
        _noteToDelete = Guid.Empty;
        return Task.CompletedTask;
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");

        using var package = new ExcelPackage();

        var worksheet = package.Workbook.Worksheets.Add("Notes");

        worksheet.Cells[1, 1].Value = "Title";
        worksheet.Cells[1, 2].Value = "Content";
        worksheet.Cells[1, 3].Value = "Created";
        worksheet.Cells[1, 4].Value = "Updated";

        var row = 2;

        foreach (var note in _filteredNotes)
        {
            worksheet.Cells[row, 1].Value = note.Title;
            worksheet.Cells[row, 2].Value = note.Content;
            worksheet.Cells[row, 3].Value = note.CreatedAt.ToString("yyyy-MM-dd HH:mm");
            worksheet.Cells[row, 4].Value = note.UpdatedAt?.ToString("yyyy-MM-dd HH:mm");

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "notes.xlsx");
    }

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            ApplyFilters();
        }
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _searchDateFrom = null;
        _searchDateTo = null;

        ApplyFilters();
    }
}

                               