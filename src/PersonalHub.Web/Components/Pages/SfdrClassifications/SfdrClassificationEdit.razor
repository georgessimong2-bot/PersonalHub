@page "/sfdrclassifications/edit/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.SfdrClassifications.Common
@using PersonalHub.Application.Features.SfdrClassifications.UpdateSfdrClassification
@using PersonalHub.Web.Services

@inject SfdrClassificationService SfdrClassificationService
@inject NavigationManager Navigation
@inject ILogger<SfdrClassificationEdit> Logger

<PageTitle>Edit SFDR Classification</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading SFDR classification...</MudText>
        </MudPaper>
    }
    else if (_sfdrClassification == null)
    {
        <MudAlert Severity="Severity.Error">SFDR Classification not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Edit SFDR Classification</MudText>
                    <MudText Typo="Typo.body2">Update SFDR classification information</MudText>
                </div>
            </MudStack>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.subtitle2">Preview</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_name) ? "Unnamed Classification" : _name)
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    @(string.IsNullOrWhiteSpace(_description) ? "No description provided." : _description)
                </MudText>
            </MudPaper>

            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="6" FullWidth="true" Class="mb-4" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_isSubmitting" OnClick="HandleUpdate">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </MudButton>
            </MudStack>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SfdrClassificationDto? _sfdrClassification;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _error = string.Empty;
    private bool _isSubmitting = false;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSfdrClassification();
    }

    private async Task LoadSfdrClassification()
    {
        try
        {
            _sfdrClassification = await SfdrClassificationService.GetSfdrClassificationByIdAsync(Id);
            if (_sfdrClassification != null)
            {
                _name = _sfdrClassification.Name;
                _description = _sfdrClassification.Description ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading SFDR classification {SfdrClassificationId}", Id);
            _error = "An error occurred while loading the SFDR classification.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _isSubmitting = true;
        _error = string.Empty;

        try
        {
            var command = new UpdateSfdrClassificationCommand(
                Id,
                _name,
                _description
            );

            await SfdrClassificationService.UpdateSfdrClassificationAsync(Id, command);
            Navigation.NavigateTo($"/sfdrclassifications/{Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating SFDR classification");
            _error = "An error occurred while updating the SFDR classification.";
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/sfdrclassifications/{Id}");
    }
}
