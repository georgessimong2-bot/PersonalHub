@page "/instruments/{Id:guid}"
@rendermode InteractiveServer

@using MudBlazor
@using MudBlazor.Charts
@using PersonalHub.Application.Features.Instruments.Common
@using PersonalHub.Application.Features.InstrumentPrices.Common
@using PersonalHub.Application.Features.InstrumentPrices.CreateInstrumentPrice
@using PersonalHub.Application.Features.InstrumentPrices.UpdateInstrumentPrice
@using PersonalHub.Web.Services
@using PersonalHub.Web.Components.Shared

@inject ILogger<InstrumentDetails> Logger
@inject NavigationManager Navigation
@inject InstrumentService InstrumentService
@inject InstrumentPriceService InstrumentPriceService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Instrument Details</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Price"
               Message="Are you sure you want to delete this price entry? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDeletePrice"
               OnCancel="CancelDeletePrice" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading instrument...</MudText>
        </MudPaper>
    }
    else if (_instrument == null)
    {
        <MudAlert Severity="Severity.Error">Instrument not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">@_instrument.Name</MudText>
                    <MudText Typo="Typo.body2">Instrument Details</MudText>
                </div>
                <MudChip T="string" Color="@(_instrument.IsActive ? Color.Success : Color.Error)" Variant="Variant.Filled">
                    @(_instrument.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudStack>

            <MudDivider Class="my-4" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Name</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@_instrument.Name</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">ISIN</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@_instrument.ISIN</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Ticker</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_instrument.Ticker ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Currency</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(string.IsNullOrWhiteSpace(_instrument.CurrencyCode) ? "-" : _instrument.CurrencyCode)</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Issuer</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_instrument.Issuer ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Country of Risk</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_instrument.CountryOfRisk ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Sector</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">@(_instrument.Sector ?? "-")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Href="@($"/instruments/edit/{Id}")">Edit</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="GoBack">Back</MudButton>
            </MudStack>

        </MudPaper>

        <MudPaper Class="pa-6 mt-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h5">Price History</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowAddPriceForm">
                    Add Price
                </MudButton>
            </MudStack>

            @if (_showPriceForm)
            {
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editingPriceId is null ? "New Price" : "Edit Price")</MudText>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="_priceDate" Label="Price Date *" Variant="Variant.Outlined" Class="mb-4" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal" @bind-Value="_price" Label="Price *" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    @if (!string.IsNullOrWhiteSpace(_priceError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_priceError</MudAlert>
                    }

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" OnClick="CancelPriceForm">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSubmittingPrice" OnClick="SavePrice">
                            @(_editingPriceId is null ? "Add Price" : "Update Price")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }

            @if (_priceChartSeries.Count > 0)
            {
                <MudChart ChartType="ChartType.Timeseries"
                          ChartSeries="@_priceChartSeries"
                          ChartOptions="_priceChartOptions"
                          Width="100%"
                          Height="350px"
                          Class="mb-10" />
            }
            else if (_prices.Count == 1)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">Add at least one more price to display the chart.</MudAlert>
            }

            <MudTable Items="@_prices" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Price Date</MudTh>
                    <MudTh>Price</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Price Date">@context.PriceDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Price">@context.Price.ToString("N2")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => ShowEditPriceForm(context))" />
                        @if (_isUserAdmin)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => ShowDeletePriceConfirm(context.Id))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No price history yet.</MudText>
                </NoRecordsContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InstrumentDto? _instrument;
    private bool _isLoading = true;
    private bool _isUserAdmin = false;

    private List<InstrumentPriceDto> _prices = new();
    private List<ChartSeries<decimal>> _priceChartSeries = new();

    private readonly TimeSeriesChartOptions _priceChartOptions = new()
    {
        ShowDataMarkers = true,
        YAxisRequireZeroPoint = false,
        TimeLabelFormat = "yyyy-MM-dd",
        TooltipTimeLabelFormat = "yyyy-MM-dd",
        XAxisTitle = "Date",
        YAxisTitle = "Price",
    };

    private bool _showPriceForm = false;
    private Guid? _editingPriceId;
    private DateTime? _priceDate = DateTime.Today;
    private decimal _price;
    private string _priceError = string.Empty;
    private bool _isSubmittingPrice = false;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _priceToDelete = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserRole();
        await LoadInstrument();
        await LoadPrices();
    }

    private async Task CheckUserRole()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isUserAdmin = user.IsInRole("ADMIN");
        }
        catch
        {
            _isUserAdmin = false;
        }
    }

    private async Task LoadInstrument()
    {
        try
        {
            _instrument = await InstrumentService.GetInstrumentByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading instrument {InstrumentId}", Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadPrices()
    {
        try
        {
            _prices = await InstrumentPriceService.GetInstrumentPricesAsync(Id) ?? new List<InstrumentPriceDto>();
            BuildPriceChart();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading price history for instrument {InstrumentId}", Id);
        }
    }

    private void BuildPriceChart()
    {
        if (_prices.Count < 2)
        {
            _priceChartSeries = new List<ChartSeries<decimal>>();
            return;
        }

        var orderedPrices = _prices.OrderBy(p => p.PriceDate).ToList();

        _priceChartSeries = new List<ChartSeries<decimal>>
        {
            new()
            {
                Name = _instrument?.Name ?? "Price",
                Data = orderedPrices.Select(p => new TimeValue<decimal>(p.PriceDate, p.Price)).ToArray(),
                Visible = true,
            }
        };
    }

    private void ShowAddPriceForm()
    {
        _editingPriceId = null;
        _priceDate = DateTime.Today;
        _price = 0;
        _priceError = string.Empty;
        _showPriceForm = true;
    }

    private void ShowEditPriceForm(InstrumentPriceDto price)
    {
        _editingPriceId = price.Id;
        _priceDate = price.PriceDate;
        _price = price.Price;
        _priceError = string.Empty;
        _showPriceForm = true;
    }

    private void CancelPriceForm()
    {
        _showPriceForm = false;
        _editingPriceId = null;
    }

    private async Task SavePrice()
    {
        if (_priceDate is null)
        {
            _priceError = "Price Date is required.";
            return;
        }

        if (_price <= 0)
        {
            _priceError = "Price must be greater than zero.";
            return;
        }

        _isSubmittingPrice = true;
        _priceError = string.Empty;

        try
        {
            if (_editingPriceId is Guid editingPriceId)
            {
                var updateCommand = new UpdateInstrumentPriceCommand(editingPriceId, _price, _priceDate.Value);
                await InstrumentPriceService.UpdateInstrumentPriceAsync(editingPriceId, updateCommand);
            }
            else
            {
                var command = new CreateInstrumentPriceCommand
                {
                    InstrumentId = Id,
                    Price = _price,
                    PriceDate = _priceDate.Value
                };

                await InstrumentPriceService.CreateInstrumentPriceAsync(command);
            }

            _showPriceForm = false;
            _editingPriceId = null;
            await LoadPrices();
        }
        catch (HttpRequestException ex)
        {
            _priceError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving instrument price");
            _priceError = "An error occurred while saving the price.";
        }
        finally
        {
            _isSubmittingPrice = false;
        }
    }

    private void ShowDeletePriceConfirm(Guid priceId)
    {
        _priceToDelete = priceId;
        _showConfirmDialog = true;
        StateHasChanged();
        _showConfirmDialog = false;

        StateHasChanged();
    }

    private async Task ConfirmDeletePrice()
    {
        if (_priceToDelete == Guid.Empty)
            return;

        try
        {
            await InstrumentPriceService.DeleteInstrumentPriceAsync(_priceToDelete);
            _priceToDelete = Guid.Empty;
            await LoadPrices();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting instrument price");
        }
    }

    private Task CancelDeletePrice()
    {
        _priceToDelete = Guid.Empty;
        _showConfirmDialog = false;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/instruments");
    }
}
