@page "/instruments/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Instruments.CreateInstrument
@using PersonalHub.Application.Features.InstrumentTypes.Common
@using PersonalHub.Application.Features.Currency.Common
@using PersonalHub.Web.Services

@inject InstrumentService InstrumentService
@inject InstrumentTypeService InstrumentTypeService
@inject CurrencyService CurrencyService
@inject NavigationManager Navigation
@inject ILogger<InstrumentCreate> Logger

<PageTitle>Create Instrument</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    <MudPaper Class="pa-6">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h4">Create Instrument</MudText>
                <MudText Typo="Typo.body2">Create a new financial instrument</MudText>
            </div>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">New Instrument</MudChip>
        </MudStack>

        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudText Typo="Typo.subtitle2">Preview</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">
                @(string.IsNullOrWhiteSpace(_name) ? "Unnamed Instrument" : _name)
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                ISIN: @(string.IsNullOrWhiteSpace(_isin) ? "Not specified" : _isin)
            </MudText>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="InstrumentTypeDto"
                    @bind-Value="_selectedInstrumentType"
                    Label="Instrument Type *"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Required="true"
                    Class="mb-4"
                    ToStringFunc="x => x?.Name ?? string.Empty">
                    @foreach (var instrumentType in _instrumentTypesList)
                    {
                        <MudSelectItem T="InstrumentTypeDto" Value="@instrumentType">@instrumentType.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="CurrencyDto"
                    @bind-Value="_selectedCurrency"
                    Label="Currency *"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Required="true"
                    Class="mb-4"
                    ToStringFunc="x => x?.Code ?? string.Empty">
                    @foreach (var currency in _currenciesList)
                    {
                        <MudSelectItem T="CurrencyDto" Value="@currency">@currency.Code - @currency.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_isin" Label="ISIN" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_ticker" Label="Ticker" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_issuer" Label="Issuer" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_countryOfRisk" Label="Country of Risk" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_sector" Label="Sector" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Checked="_isActive" Label="Is Active" Class="mb-4" />
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_isSubmitting || _selectedInstrumentType is null || _selectedCurrency is null" OnClick="HandleCreate">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">Creating...</span>
                }
                else
                {
                    <span>Create Instrument</span>
                }
            </MudButton>
        </MudStack>

    </MudPaper>

</MudContainer>

@code {
    private List<InstrumentTypeDto> _instrumentTypesList = [];
    private List<CurrencyDto> _currenciesList = [];
    private InstrumentTypeDto? _selectedInstrumentType;
    private CurrencyDto? _selectedCurrency;
    private string _name = string.Empty;
    private string _isin = string.Empty;
    private string? _ticker;
    private string? _issuer;
    private string? _countryOfRisk;
    private string? _sector;
    private bool _isActive = true;
    private string _error = string.Empty;
    private bool _isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instrumentTypesList = await InstrumentTypeService.GetInstrumentTypesAsync();
            _currenciesList = await CurrencyService.GetCurrenciesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            _error = "Failed to load instrument types or currencies.";
        }
    }

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_isin))
        {
            _error = "ISIN is required.";
            return;
        }

        if (_selectedInstrumentType is null)
        {
            _error = "Instrument Type is required.";
            return;
        }

        if (_selectedCurrency is null)
        {
            _error = "Currency is required.";
            return;
        }

        _isSubmitting = true;
        _error = string.Empty;

        try
        {
            var command = new CreateInstrumentCommand
            {
                InstrumentTypeId = _selectedInstrumentType.Id,
                CurrencyId = _selectedCurrency.Id,
                Name = _name,
                ISIN = _isin,
                Ticker = _ticker,
                Issuer = _issuer,
                CountryOfRisk = _countryOfRisk,
                Sector = _sector,
                IsActive = _isActive
            };

            var id = await InstrumentService.CreateInstrumentAsync(command);
            Navigation.NavigateTo($"/instruments/{id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating instrument");
            _error = "An error occurred while creating the instrument.";
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/instruments");
    }
}
