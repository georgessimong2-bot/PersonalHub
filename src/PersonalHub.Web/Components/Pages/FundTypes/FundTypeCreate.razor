@page "/fundtypes/create"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.FundTypes.CreateFundType
@using PersonalHub.Web.Services

@inject FundTypeService FundTypeService
@inject NavigationManager Navigation
@inject ILogger<FundTypeCreate> Logger

<PageTitle>Create Fund Type</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    <MudPaper Class="pa-6">

        <!-- HEADER -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>

                <MudText Typo="Typo.h4">
                    Create Fund Type
                </MudText>

                <MudText Typo="Typo.body2">
                    Create a new fund type classification
                </MudText>

            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">

                New Fund Type

            </MudChip>

        </MudStack>

        <!-- PREVIEW -->

        <MudPaper Class="pa-4 mb-4"
                  Outlined="true">

            <MudText Typo="Typo.subtitle2">
                Preview
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_name)
                    ? "Unnamed Fund Type"
                    : _name)

            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_description)
                    ? "No description provided."
                    : _description)

            </MudText>

        </MudPaper>

        <!-- FORM -->

        <MudTextField T="string"
                      @bind-Value="_name"
                      Label="Name"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_description"
                      Label="Description"
                      Variant="Variant.Outlined"
                      Lines="6"
                      FullWidth="true"
                      Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">

                @_error

            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="Cancel">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="_isSubmitting"
                       OnClick="HandleCreateFundType">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />

                    <span class="ms-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create Fund Type
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>
    

</MudContainer>

@code {


private string _name = string.Empty;

    private string? _description;

    private string? _error;

    private bool _isSubmitting;

    private async Task HandleCreateFundType()
    {
        try
        {
            _error = null;
            _isSubmitting = true;

            if (string.IsNullOrWhiteSpace(_name))
            {
                _error = "Name is required.";
                return;
            }

            var command = new CreateFundTypeCommand(
                _name.Trim(),
                _description?.Trim());

            await FundTypeService.CreateFundTypeAsync(command);

            Navigation.NavigateTo("/fundtypes");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating fund type");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/fundtypes");
    }


}
