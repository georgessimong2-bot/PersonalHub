@page "/fundtypes"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.FundTypes.Common
@using PersonalHub.Web.Services

@inject FundTypeService FundTypeService
@inject ILogger<FundTypes> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Fund Types</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    
    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading fund types...
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Fund Types
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_filteredFundTypes.Count fund type(s)
                    </MudText>

                </div>

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel">

                        Export Excel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/fundtypes/create"
                               StartIcon="@Icons.Material.Filled.Add">

                        Create Fund Type

                    </MudButton>

                </MudStack>

            </MudStack>

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="8">

                    <MudTextField T="string"
                                  @bind-Value="SearchTerm"
                                  Label="Search Fund Types"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">

                        Clear Filters

                    </MudButton>

                </MudItem>

            </MudGrid>

            <MudTable Items="_filteredFundTypes"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Bordered="true"
                      Elevation="0">

                <HeaderContent>

                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Name">

                        <MudChip T="string"
                                 Variant="Variant.Outlined"
                                 Color="Color.Info">

                            @context.Name

                        </MudChip>

                    </MudTd>

                    <MudTd DataLabel="Description">

                        @if (string.IsNullOrWhiteSpace(context.Description))
                        {
                            <MudText>-</MudText>
                        }
                        else
                        {
                            <MudTooltip Text="@context.Description">

                                @(context.Description.Length > 120
                                    ? context.Description[..120] + "..."
                                    : context.Description)

                            </MudTooltip>
                        }

                    </MudTd>

                    <MudTd DataLabel="Actions">

                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Href="@($"/fundtypes/details/{context.Id}")" />


                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Href="@($"/fundtypes/edit/{context.Id}")" />

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }
    

</MudContainer>

@code {


private List<FundTypeDto> _fundTypes = [];
    private List<FundTypeDto> _filteredFundTypes = [];

    private bool _isLoading = true;

    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fundTypes =
                await FundTypeService.GetFundTypesAsync();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error loading fund types");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        _filteredFundTypes =
            string.IsNullOrWhiteSpace(_searchTerm)
            ? _fundTypes
            : _fundTypes.Where(x =>
                x.Name.Contains(
                    _searchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (x.Description ?? "")
                    .Contains(
                        _searchTerm,
                        StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Name)
            .ToList();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal(
            "Georges Simon");

        using var package = new ExcelPackage();

        var worksheet =
            package.Workbook.Worksheets.Add("FundTypes");

        worksheet.Cells[1, 1].Value = "Name";
        worksheet.Cells[1, 2].Value = "Description";

        var row = 2;

        foreach (var fundType in _filteredFundTypes)
        {
            worksheet.Cells[row, 1].Value = fundType.Name;
            worksheet.Cells[row, 2].Value = fundType.Description;

            row++;
        }

        worksheet.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "fundtypes.xlsx");
    }


}
