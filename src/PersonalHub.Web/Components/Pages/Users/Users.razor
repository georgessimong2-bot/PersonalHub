@page "/users"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using PersonalHub.Application.Features.Users.Common
@using OfficeOpenXml

@inject UserService UsersService
@inject ILogger<Users> Logger
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Roles="ADMIN">
        <Authorized>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete User"
               Message="Are you sure you want to delete this user? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading users...
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        User Management
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @_filteredUsers.Count user(s)
                    </MudText>

                </div>

                <MudStack Row="true" Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportToExcel">

                        Export Excel

                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/users/create">

                        Create

                    </MudButton>

                </MudStack>

            </MudStack>

            <MudTextField T="string"
                          @bind-Value="Search"
                          Label="Search users"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mb-4" />

            <MudTable Items="_filteredUsers"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      Bordered="true"
                      Elevation="0">

                <HeaderContent>

                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Id</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd DataLabel="Email">
                        @context.Email
                    </MudTd>

                    <MudTd DataLabel="Role">

                        @if (context.Role == "ADMIN")
                        {
                            <MudChip T="string"
                                     Variant="Variant.Filled"
                                     Color="@(context.Role == "ADMIN"
                                                  ? Color.Error
                                                  : Color.Success)">
                                @context.Role
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Variant="Variant.Filled"
                                     Color="@(context.Role == "USER"
                                                  ? Color.Transparent
                                                  : Color.Success)">
                                @context.Role
                            </MudChip>
                        }

                    </MudTd>

                    <MudTd DataLabel="Id">

                        <MudTooltip Text="@context.Id">

                            @(context.Id.Length > 12
                                ? context.Id[..12] + "..."
                                : context.Id)

                        </MudTooltip>

                    </MudTd>

                    <MudTd DataLabel="Actions">

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Href="@($"/users/edit/{context.Id}")" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => ShowDeleteConfirm(context.Id))" />

                    </MudTd>

                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>

            </MudTable>

        </MudPaper>
    }
</MudContainer>

@code {

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private List<UserDto> _users = [];
    private List<UserDto> _filteredUsers = [];
    private string _userToDelete = string.Empty;

    private bool _isLoading = true;

    private string _search = "";


    // 🔥 SEARCH PROPERTY (IMPORTANT)
    private string Search
    {
        get => _search;
        set
        {
            _search = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Verify user is admin before loading
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login?returnUrl=/users", true);
            return;
        }

        if (!user.IsInRole("ADMIN"))
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _isLoading = true;

        try
        {
            _users = await UsersService.GetUsersAsync() ?? [];
            ApplyFilters();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowDeleteConfirm(string id)
    {
        _userToDelete = id;
        _showConfirmDialog = true;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _filteredUsers = string.IsNullOrWhiteSpace(_search)
            ? _users
            : _users.Where(x =>
                x.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || x.Role.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

        StateHasChanged();
    }

   


    private async Task ExportToExcel()
    {
        ExcelPackage.License.SetNonCommercialPersonal("Georges Simon");
        

        using var package = new ExcelPackage();
        var ws = package.Workbook.Worksheets.Add("Users");

        ws.Cells[1, 1].Value = "Email";
        ws.Cells[1, 2].Value = "Role";
        ws.Cells[1, 3].Value = "Id";

        int row = 2;

        foreach (var u in _filteredUsers)
        {
            ws.Cells[row, 1].Value = u.Email;
            ws.Cells[row, 2].Value = u.Role;
            ws.Cells[row, 3].Value = u.Id;
            row++;
        }

        ws.Cells.AutoFitColumns();

        var bytes = package.GetAsByteArray();

        await JSRuntime.InvokeVoidAsync(
            "downloadFile",
            bytes,
            "users.xlsx");
    }

 
    private async Task ConfirmDelete()
    {
        if (_userToDelete == string.Empty)
            return;

        await Delete(_userToDelete  );
        _userToDelete = string.Empty;
    }

    private async Task Delete(string id)
    {
        try
        {
            Logger.LogInformation("Deleting user {Id}", id);

            await UsersService.DeleteAsync(id);
            _users.RemoveAll(x => x.Id == id);

            ApplyFilters();

            Logger.LogInformation("User {Id} deleted", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user {Id}", id);
        }
    }

    private Task CancelDelete()
    {
        _userToDelete = string.Empty;
        return Task.CompletedTask;
    }

        </Authorized>
        <NotAuthorized>
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                <MudAlert Severity="Severity.Warning">
                    Only administrators can access this page.
                </MudAlert>
            </MudContainer>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
