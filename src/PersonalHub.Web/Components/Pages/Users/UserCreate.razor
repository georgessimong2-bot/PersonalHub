@page "/users/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "ADMIN")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using PersonalHub.Application.Features.Users.CreateUser

@inject UserService UserService
@inject NavigationManager Navigation
@inject ILogger<UserCreate> Logger

<PageTitle>Create User</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    <MudPaper Class="pa-6">

        <!-- HEADER -->
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>
                <MudText Typo="Typo.h4">Create User</MudText>
                <MudText Typo="Typo.body2">Create a new application user</MudText>
            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">
                New User
            </MudChip>
        </MudStack>

        <!-- ERROR -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <!-- FORM -->
        <MudTextField T="string"
                      @bind-Value="_model.Email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_model.Password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudSelect T="string"
                   Label="Role"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   @bind-Value="_model.Role"
                   Class="mb-6">
            <MudSelectItem T="string" Value="@("USER")">User</MudSelectItem>
            <MudSelectItem T="string" Value="@("ADMIN")">Admin</MudSelectItem>
        </MudSelect>

        <!-- BUTTONS -->
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
            <MudButton Variant="Variant.Text" OnClick="Cancel">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleCreate"
                       Disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Creating...</MudText>
                }
                else
                {
                    <MudText>Create User</MudText>
                }
            </MudButton>
        </MudStack>

    </MudPaper>

</MudContainer>

@code {

    private CreateUserCommand _model = new();
    private string _error = string.Empty;
    private bool _isSubmitting = false;

    private async Task HandleCreate()
    {
        _error = string.Empty;
        _isSubmitting = true;

        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _error = "Email is required.";
            _isSubmitting = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Password))
        {
            _error = "Password is required.";
            _isSubmitting = false;
            return;
        }

        try
        {
            await UserService.CreateAsync(_model);
            Navigation.NavigateTo("/users");
        }
        catch (HttpRequestException ex)
        {
            _error = $"Failed to create user: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating user");
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }
}
