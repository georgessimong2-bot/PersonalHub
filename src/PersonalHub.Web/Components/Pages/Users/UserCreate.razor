@page "/users/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "ADMIN")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using PersonalHub.Application.Features.Users.CreateUser

@inject UserService UserService
@inject NavigationManager Navigation
@inject ILogger<UserCreate> Logger

<PageTitle>Create User</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    <MudPaper Class="pa-6">

        <!-- HEADER -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mb-4">

            <div>

                <MudText Typo="Typo.h4">
                    Create User
                </MudText>

                <MudText Typo="Typo.body2">
                    Create a new application user
                </MudText>

            </div>

            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled">

                New User

            </MudChip>

        </MudStack>

        <!-- PREVIEW -->

        <MudPaper Class="pa-4 mb-4"
                  Outlined="true">

            <MudText Typo="Typo.subtitle2">
                Preview
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mt-2">

                @(string.IsNullOrWhiteSpace(_model.Email)
                    ? "user@example.com"
                    : _model.Email)

            </MudText>

            <MudChip T="string"
                     Color="@GetRoleColor()"
                     Class="mt-2">

                @(_model.Role ?? "USER")

            </MudChip>

        </MudPaper>

        <!-- FORM -->

        <MudTextField T="string"
                      @bind-Value="_model.Email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudTextField T="string"
                      @bind-Value="_model.Password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Required="true"
                      Class="mb-4" />

        <MudSelect T="string"
                   Label="Role"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   @bind-Value="_model.Role"
                   Class="mb-4">

            <MudSelectItem T="string"
                           Value="@("USER")">

                User

            </MudSelectItem>

            <MudSelectItem T="string"
                           Value="@("ADMIN")">

                Administrator

            </MudSelectItem>

        </MudSelect>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-4">

                @_error

            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Spacing="2">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="Cancel">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Disabled="_isSubmitting"
                       OnClick="Save">

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />

                    <span class="ms-2">
                        Creating...
                    </span>
                }
                else
                {
                    <span>
                        Create User
                    </span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>
    

</MudContainer>

@code {


private CreateUserCommand _model = new()
{
    Role = "USER"
};

    private bool _isSubmitting;

    private string? _error;

    private async Task Save()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_model.Email))
            {
                _error = "Email is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_model.Password))
            {
                _error = "Password is required.";
                return;
            }

            var success =
                await UserService.CreateAsync(_model);

            if (!success)
            {
                _error = "Failed to create user.";
                return;
            }

            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating user");

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Color GetRoleColor()
    {
        return _model.Role == "ADMIN"
            ? Color.Error
            : Color.Success;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }


}
