@page "/users/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using PersonalHub.Application.Features.Users.CreateUser

@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>Créer un utilisateur</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5" Class="mb-4">
            Nouvel utilisateur
        </MudText>

        <MudTextField Label="Email"
                      Variant="Variant.Outlined"
                      @bind-Value="_model.Email" />

        <MudTextField Label="Mot de passe"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Class="mt-4"
                      @bind-Value="_model.Password" />

        <MudSelect T="string"
                   Label="Rôle"
                   Variant="Variant.Outlined"
                   Class="mt-4"
                   @bind-Value="_model.Role">

            <MudSelectItem T="string" Value="@("User")">
                User
            </MudSelectItem>

            <MudSelectItem T="string" Value="@("Admin")">
                Admin
            </MudSelectItem>

        </MudSelect>

        <MudStack Row="true" Class="mt-6">

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Save">
                Enregistrer
            </MudButton>

            <MudButton Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       OnClick="Cancel">
                Annuler
            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {

    private CreateUserCommand _model = new();

    private async Task Save()
    {
        var success =
            await UserService.CreateAsync(_model);

        if (success)
        {
            Navigation.NavigateTo("/users");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }
}