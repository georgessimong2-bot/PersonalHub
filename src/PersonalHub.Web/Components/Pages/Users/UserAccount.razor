@page "/account"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using MudBlazor
@using PersonalHub.Application.Features.Account.Common
@using PersonalHub.Web.Configuration
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Application.Features.Users.Common;

@inject UserService UserService
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject IOptions<ApiSettings> ApiSettings

<PageTitle>My Account</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_loading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

            <MudText Class="mt-4">
                Loading account...
            </MudText>

        </MudPaper>
    }
    else
    {
        <!-- PROFILE HEADER -->

        <MudPaper Class="pa-6 mb-6" Elevation="2">

            <MudStack Row="true"
                      Spacing="4"
                      AlignItems="AlignItems.Center">

                <MudAvatar Size="Size.Large"
                           Color="Color.Primary"
                           Style="width:120px;height:120px;">

                    @if (!string.IsNullOrWhiteSpace(_profilePictureUrl))
                    {
                        <MudImage Src="@GetProfileImageUrl()"
                                  Alt="Profile Picture" />
                    }
                    else
                    {
                        @GetInitials()
                    }

                </MudAvatar>



                <MudStack Spacing="1">

                    <MudText Typo="Typo.h4">
                        @($"{_model.FirstName} {_model.LastName}".Trim())
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @_email
                    </MudText>

                    <MudChip T="string"
                             Color="Color.Primary"
                             Variant="Variant.Filled">

                        @_role

                    </MudChip>

                    <InputFile OnChange="UploadPicture" />

                    <MudText Typo="Typo.caption">
                        JPG, PNG, WEBP (max 2 MB)
                    </MudText>

                </MudStack>

            </MudStack>

        </MudPaper>

       

        <!-- ACCOUNT SECTIONS -->

        <MudExpansionPanels MultiExpansion="true">

            <!-- PERSONAL INFORMATION -->

            <MudExpansionPanel Text="Personal Information"
                               Expanded="true">

                <MudGrid>

                    <MudItem xs="12" md="6">

                        <MudTextField @bind-Value="_model.FirstName"
                                      Label="First Name"
                                      Variant="Variant.Outlined"
                                      FullWidth="true" />

                    </MudItem>

                    <MudItem xs="12" md="6">

                        <MudTextField @bind-Value="_model.LastName"
                                      Label="Last Name"
                                      Variant="Variant.Outlined"
                                      FullWidth="true" />

                    </MudItem>

                </MudGrid>

            </MudExpansionPanel>

            <!-- CONTACT INFORMATION -->

            <MudExpansionPanel Text="Contact Information">

                <MudStack Spacing="3">

                    <MudTextField T="string"
                                  Value="_email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"
                                  FullWidth="true" />

                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  Label="Phone Number"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                    <MudTextField @bind-Value="_model.Address"
                                  Label="Address"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  FullWidth="true" />

                </MudStack>

            </MudExpansionPanel>

            <!-- SECURITY -->

            <MudExpansionPanel Text="Security">

                <MudStack Spacing="3">

                    <MudTextField Label="Current Password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_password.CurrentPassword" />

                    <MudTextField Label="New Password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_password.NewPassword" />

                    <MudTextField Label="Confirm Password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_password.ConfirmPassword" />

                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.LockReset"
                               OnClick="ChangePasswordAsync">

                        Change Password

                    </MudButton>

                </MudStack>

            </MudExpansionPanel>

        </MudExpansionPanels>

        <MudDivider Class="my-6" />

        <!-- ACTIONS -->

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween">

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteForever">

                Delete Account

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving"
                       OnClick="SaveAsync">

                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Class="me-2" />
                }

                Save Changes

            </MudButton>

        </MudStack>
    }

</MudContainer>

@code {

    private bool _loading = true;
    private bool _saving;

    private string _email = string.Empty;
    private string _role = string.Empty;

    private string? _profilePictureUrl;

    private readonly ChangePasswordDto _password = new();

    private UpdateProfileDto _model = new();

    // Dashboard stats (optional)
    private int _goalsCount;
    private int _notesCount;
    private int _fundsCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = AuthService.GetUserId();

            if (string.IsNullOrWhiteSpace(userId))
                return;

            var user = await UserService.GetByIdAsync(userId);

            if (user is not null)
            {
                _email = user.Email;
                _role = user.Role;

                _profilePictureUrl = user.ProfilePictureUrl;

                _model = new UpdateProfileDto
                {
                    FirstName = user.FirstName ?? string.Empty,
                    LastName = user.LastName ?? string.Empty,
                    PhoneNumber = user.PhoneNumber ?? string.Empty,
                    Address = user.Address ?? string.Empty
                };
            }
       
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            var success =
                await UserService.UpdateProfileAsync(_model);

            Snackbar.Add(
                success
                    ? "Profile updated successfully."
                    : "Unable to update profile.",
                success
                    ? Severity.Success
                    : Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_password.NewPassword != _password.ConfirmPassword)
        {
            Snackbar.Add(
                "Passwords do not match.",
                Severity.Error);

            return;
        }

        var success =
            await UserService.ChangePasswordAsync(_password);

        Snackbar.Add(
            success
                ? "Password changed successfully."
                : "Unable to change password.",
            success
                ? Severity.Success
                : Severity.Error);

        if (success)
        {
            _password.CurrentPassword = string.Empty;
            _password.NewPassword = string.Empty;
            _password.ConfirmPassword = string.Empty;
        }
    }

    private async Task UploadPicture(
        InputFileChangeEventArgs e)
    {
        var file = e.File;

        var url =
            await UserService.UploadProfilePictureAsync(file);

        if (url is null)
        {
            Snackbar.Add(
                "Unable to upload image.",
                Severity.Error);

            return;
        }

        _profilePictureUrl = url;

        Snackbar.Add(
            "Profile picture updated.",
            Severity.Success);

        StateHasChanged();
    }

    private string GetInitials()
    {
        var first =
            string.IsNullOrWhiteSpace(_model.FirstName)
                ? ""
                : _model.FirstName[..1];

        var last =
            string.IsNullOrWhiteSpace(_model.LastName)
                ? ""
                : _model.LastName[..1];

        var initials =
            $"{first}{last}".ToUpper();

        return string.IsNullOrWhiteSpace(initials)
            ? "U"
            : initials;
    }

    private string GetProfileImageUrl()
    {
        return _profilePictureUrl ?? string.Empty;
    }
}