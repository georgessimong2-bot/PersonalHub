@page "/users/edit/{Id}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "ADMIN")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using PersonalHub.Application.Features.Users.UpdateUser

@inject UserService UserService
@inject NavigationManager Navigation
@inject ILogger<UserEdit> Logger

<PageTitle>Edit User</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8 mb-8">

    
    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Class="mt-4">
                Loading user...
            </MudText>

        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6">

            <!-- HEADER -->

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="mb-4">

                <div>

                    <MudText Typo="Typo.h4">
                        Edit User
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Update user information and permissions
                    </MudText>

                </div>

                <MudChip T="string"
                         Color="@GetRoleColor()"
                         Variant="Variant.Filled">

                    @_model.Role

                </MudChip>

            </MudStack>

            <!-- SUMMARY -->

            <MudGrid Class="mb-4">

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            User Id
                        </MudText>

                        <MudText Typo="Typo.body2">
                            @Id
                        </MudText>

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-3">

                        <MudText Typo="Typo.caption">
                            Current Role
                        </MudText>

                        <MudChip T="string"
                                 Color="@GetRoleColor()">

                            @_model.Role

                        </MudChip>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <!-- FORM -->

            <MudTextField T="string"
                          @bind-Value="_model.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          Class="mb-4" />

            <MudSelect T="string"
                       Label="Role"
                       Variant="Variant.Outlined"
                       FullWidth="true"
                       @bind-Value="_model.Role"
                       Class="mb-4">

                <MudSelectItem T="string"
                               Value="@("USER")">

                    User

                </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@("ADMIN")">

                    Administrator

                </MudSelectItem>

            </MudSelect>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error"
                          Class="mb-4">

                    @_error

                </MudAlert>
            }

            <MudDivider Class="my-4" />

            <!-- ACTIONS -->

            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Spacing="2">

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="Cancel">

                    Cancel

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="_isSubmitting"
                           OnClick="Save">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true" />

                        <span class="ms-2">
                            Saving...
                        </span>
                    }
                    else
                    {
                        <span>
                            Save Changes
                        </span>
                    }

                </MudButton>

            </MudStack>

        </MudPaper>
    }
    

</MudContainer>

@code {


[Parameter]
    public string Id { get; set; } = string.Empty;

    private bool _isLoading = true;
    private bool _isSubmitting;

    private string? _error;

    private UpdateUserCommand _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user =
                await UserService.GetByIdAsync(Id);

            if (user is not null)
            {
                _model.Id = user.Id;
                _model.Email = user.Email;
                _model.Role = user.Role;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error loading user {UserId}",
                Id);

            _error = "Unable to load user.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Save()
    {
        try
        {
            _isSubmitting = true;
            _error = null;

            if (string.IsNullOrWhiteSpace(_model.Email))
            {
                _error = "Email is required.";
                return;
            }

            var success =
                await UserService.UpdateAsync(
                    Id,
                    _model);

            if (!success)
            {
                _error = "Failed to update user.";
                return;
            }

            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error updating user {UserId}",
                Id);

            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Color GetRoleColor()
    {
        return _model.Role == "ADMIN"
            ? Color.Error
            : Color.Success;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }


}
