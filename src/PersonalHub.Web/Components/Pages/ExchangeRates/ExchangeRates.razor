@page "/exchange-rates"
@rendermode InteractiveServer

@using MudBlazor
@using OfficeOpenXml
@using PersonalHub.Application.Features.ExchangeRates.Common
@using PersonalHub.Application.Features.Currency.Common
@using PersonalHub.Web.Services
@using PersonalHub.Web.Services.Auth
@using PersonalHub.Web.Components.Shared

@inject ExchangeRateService ExchangeRateService
@inject CurrencyService CurrencyService
@inject ILogger<ExchangeRates> Logger
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Exchange Rates</PageTitle>

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Exchange Rate"
               Message="Are you sure you want to delete this exchange rate? This action cannot be undone."
               ConfirmButtonText="Delete"
               IsVisible="_showConfirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

    @if (_isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-4">Loading exchange rates...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h4">Exchange Rates</MudText>
                    <MudText Typo="Typo.body2">@_filteredExchangeRates.Count exchange rate(s)</MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel">
                        Export Excel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/exchange-rates/create" StartIcon="@Icons.Material.Filled.Add">
                        Create Exchange Rate
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudGrid Class="mb-4">
                <MudItem xs="12" md="3">
                    <MudSelect T="CurrencyDto" @bind-Value="_selectedFromCurrencyFilter" Label="From Currency" Variant="Variant.Outlined" Clearable="true" ToStringFunc="x => x?.Code ?? string.Empty">
                        @foreach (var currency in _currenciesList)
                        {
                            <MudSelectItem T="CurrencyDto" Value="@currency">@currency.Code - @currency.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="CurrencyDto" @bind-Value="_selectedToCurrencyFilter" Label="To Currency" Variant="Variant.Outlined" Clearable="true" ToStringFunc="x => x?.Code ?? string.Empty">
                        @foreach (var currency in _currenciesList)
                        {
                            <MudSelectItem T="CurrencyDto" Value="@currency">@currency.Code - @currency.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_effectiveDateFilter" Label="Effective Date" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudTable Items="@_filteredExchangeRates" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>From Currency</MudTh>
                    <MudTh>To Currency</MudTh>
                    <MudTh>Effective Date</MudTh>
                    <MudTh>Rate</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="From Currency">@context.FromCurrencyCode</MudTd>
                    <MudTd DataLabel="To Currency">@context.ToCurrencyCode</MudTd>
                    <MudTd DataLabel="Effective Date">@context.EffectiveDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Rate">@context.Rate.ToString("N4")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Href="@($"/exchange-rates/edit/{context.Id}")" />
                        <DeleteButtonAdmin OnClick="@(() => ShowDeleteConfirm(context.Id))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private List<ExchangeRateDto> _exchangeRates = new();
    private List<ExchangeRateDto> _filteredExchangeRates = new();
    private List<CurrencyDto> _currenciesList = new();
    private CurrencyDto? _selectedFromCurrencyFilter;
    private CurrencyDto? _selectedToCurrencyFilter;
    private DateTime? _effectiveDateFilter;
    private bool _isLoading = true;

    private ConfirmDialog? _confirmDialog;
    private bool _showConfirmDialog = false;
    private Guid _exchangeRateToDelete = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currenciesList = await CurrencyService.GetCurrenciesAsync();
            await LoadExchangeRatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading exchange rates");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadExchangeRatesAsync()
    {
        _exchangeRates = await ExchangeRateService.GetExchangeRatesAsync();
        FilterExchangeRates();
    }

    private void FilterExchangeRates()
    {
        _filteredExchangeRates = _exchangeRates;

        if (_selectedFromCurrencyFilter != null)
        {
            _filteredExchangeRates = _filteredExchangeRates
                .Where(x => x.FromCurrencyId == _selectedFromCurrencyFilter.Id)
                .ToList();
        }

        if (_selectedToCurrencyFilter != null)
        {
            _filteredExchangeRates = _filteredExchangeRates
                .Where(x => x.ToCurrencyId == _selectedToCurrencyFilter.Id)
                .ToList();
        }

        if (_effectiveDateFilter.HasValue)
        {
            _filteredExchangeRates = _filteredExchangeRates
                .Where(x => x.EffectiveDate.Date == _effectiveDateFilter.Value.Date)
                .ToList();
        }
    }

    private void ClearFilters()
    {
        _selectedFromCurrencyFilter = null;
        _selectedToCurrencyFilter = null;
        _effectiveDateFilter = null;
        FilterExchangeRates();
    }

    private void ShowDeleteConfirm(Guid id)
    {
        _exchangeRateToDelete = id;
        _showConfirmDialog = true;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await ExchangeRateService.DeleteExchangeRateAsync(_exchangeRateToDelete);
            await LoadExchangeRatesAsync();
            _showConfirmDialog = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting exchange rate");
        }
    }

    private void CancelDelete()
    {
        _showConfirmDialog = false;
        _exchangeRateToDelete = Guid.Empty;
    }

    private async Task ExportToExcel()
    {
        try
        {
            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

            using var package = new ExcelPackage();
            var worksheet = package.Workbook.Worksheets.Add("Exchange Rates");

            // Headers
            worksheet.Cells[1, 1].Value = "From Currency";
            worksheet.Cells[1, 2].Value = "To Currency";
            worksheet.Cells[1, 3].Value = "Effective Date";
            worksheet.Cells[1, 4].Value = "Rate";

            // Style headers
            using (var range = worksheet.Cells[1, 1, 1, 4])
            {
                range.Style.Font.Bold = true;
                range.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                range.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.LightGray);
            }

            // Data
            var row = 2;
            foreach (var exchangeRate in _filteredExchangeRates)
            {
                worksheet.Cells[row, 1].Value = exchangeRate.FromCurrencyCode;
                worksheet.Cells[row, 2].Value = exchangeRate.ToCurrencyCode;
                worksheet.Cells[row, 3].Value = exchangeRate.EffectiveDate.ToString("yyyy-MM-dd");
                worksheet.Cells[row, 4].Value = exchangeRate.Rate;
                row++;
            }

            worksheet.Cells.AutoFitColumns();

            var content = package.GetAsByteArray();
            var fileName = $"ExchangeRates_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(content));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting to Excel");
        }
    }
}
