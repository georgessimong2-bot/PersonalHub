@page "/dashboard"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Application.Features.Dashboard.Common
@using PersonalHub.Web.Services

@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    @if (_loading)
    {
        <MudPaper Class="pa-6 text-center">
            <MudProgressCircular Indeterminate="true" />
        </MudPaper>
    }
    else
    {
        <!-- Welcome -->

        <MudPaper Class="pa-6 mb-6" Elevation="2">

            <MudText Typo="Typo.h4">
                Welcome to PersonalHub 👋
            </MudText>

            <MudText Typo="Typo.body1">
                Here's a quick overview of your data.
            </MudText>

        </MudPaper>

        <!-- Statistics -->

        <MudGrid>

            <MudItem xs="12" sm="6" md="3">

                <MudCard Class="dashboard-card"
                         Style="cursor:pointer"
                         @onclick="GoToGoals">

                    <MudCardContent>

                        <MudText Typo="Typo.h6">
                            Goals
                        </MudText>

                        <MudText Typo="Typo.h3">
                            @_dashboard.GoalsCount
                        </MudText>

                    </MudCardContent>

                </MudCard>

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudCard Class="dashboard-card"
                         Style="cursor:pointer"
                         @onclick="GoToNotes">

                    <MudCardContent>

                        <MudText Typo="Typo.h6">
                            Notes
                        </MudText>

                        <MudText Typo="Typo.h3">
                            @_dashboard.NotesCount
                        </MudText>

                    </MudCardContent>

                </MudCard>

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudCard Class="dashboard-card"
                         Style="cursor:pointer"
                         @onclick="GoToFunds">

                    <MudCardContent>

                        <MudText Typo="Typo.h6">
                            Funds
                        </MudText>

                        <MudText Typo="Typo.h3">
                            @_dashboard.FundsCount
                        </MudText>

                    </MudCardContent>

                </MudCard>

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudCard Class="dashboard-card"
                         Style="cursor:pointer"
                         @onclick="GoToSubFunds">

                    <MudCardContent>

                        <MudText Typo="Typo.h6">
                            Sub Funds
                        </MudText>

                        <MudText Typo="Typo.h3">
                            @_dashboard.SubFundsCount
                        </MudText>

                    </MudCardContent>

                </MudCard>

            </MudItem>

            <MudItem xs="12" sm="6" md="3">

                <MudCard Class="dashboard-card"
                         Style="cursor:pointer"
                         @onclick="GoToShareClasses">

                    <MudCardContent>

                        <MudText Typo="Typo.h6">
                            Share Classes
                        </MudText>

                        <MudText Typo="Typo.h3">
                            @_dashboard.ShareClassesCount
                        </MudText>

                    </MudCardContent>

                </MudCard>

            </MudItem>

        </MudGrid>

        <!-- Quick Actions -->

        <MudPaper Class="pa-6 mt-6"
                  Elevation="2">

            <MudText Typo="Typo.h5"
                     Class="mb-4">
                Quick Actions
            </MudText>

            <MudStack Row="true"
                      Spacing="2">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="CreateGoal">

                    New Goal

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="CreateNote">

                    New Note

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="CreateFund">

                    New Fund

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           OnClick="CreateSubFund">

                    New SubFund

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           OnClick="CreateShareClass">

                    New ShareClass

                </MudButton>

            </MudStack>

        </MudPaper>

    }

</MudContainer>

<style>
    .dashboard-card {
        transition: all .2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
        }
</style>

@code {

    private bool _loading = true;

    private DashboardDto _dashboard = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result =
                await DashboardService.GetAsync();

            if (result is not null)
            {
                _dashboard = result;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToGoals()
        => Navigation.NavigateTo("/goals");

    private void GoToNotes()
        => Navigation.NavigateTo("/notes");

    private void GoToFunds()
        => Navigation.NavigateTo("/funds");

    private void GoToSubFunds()
        => Navigation.NavigateTo("/subfunds");

    private void GoToShareClasses()
        => Navigation.NavigateTo("/shareclasses");

    private void CreateGoal()
        => Navigation.NavigateTo("/goals/create");

    private void CreateNote()
        => Navigation.NavigateTo("/notes/create");

    private void CreateFund()
        => Navigation.NavigateTo("/funds/create");

    private void CreateSubFund()
        => Navigation.NavigateTo("/subfunds/create");

    private void CreateShareClass()
        => Navigation.NavigateTo("/shareclasses/create");
}