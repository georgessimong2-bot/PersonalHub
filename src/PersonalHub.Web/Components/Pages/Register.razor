@page "/register"
@rendermode InteractiveServer

@using MudBlazor
@using PersonalHub.Web.Services.Auth

@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Register - PersonalHub</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Class="pa-8 rounded-lg" Elevation="3">

        <div class="text-center mb-6">
            <MudText Typo="Typo.h4">
                Create Account
            </MudText>

            <MudText Typo="Typo.body2">
                Sign up to start using PersonalHub
            </MudText>
        </div>

        @if (_errors.Any())
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                <ul class="mb-0 ps-3">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </MudAlert>
        }

        <MudTextField T="string" @bind-Value="_email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Disabled="_isLoading"
                      Immediate="true"
                      Class="mb-4" />

        <MudTextField T="string" @bind-Value="_password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Disabled="_isLoading"
                      Class="mb-4" />

        <MudTextField T="string" @bind-Value="_confirmPassword"
                      Label="Confirm Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Disabled="_isLoading"
                      Class="mb-6" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="_isLoading"
                   OnClick="RegisterAsync">

            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2" />
                <span>Creating account...</span>
            }
            else
            {
                <span>Register</span>
            }

        </MudButton>

        <div class="text-center mt-4">
            <MudText Typo="Typo.body2">
                Already have an account?
                <MudLink Href="/login">
                    Sign in
                </MudLink>
            </MudText>
        </div>

    </MudPaper>
</MudContainer>

@code {

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    private bool _isLoading;

    private readonly List<string> _errors = [];

    private async Task RegisterAsync()
    {
        _errors.Clear();

        ValidateForm();

        if (_errors.Count > 0)
            return;

        _isLoading = true;

        try
        {
            var result = await AuthService.RegisterAsync(
                _email.Trim(),
                _password);

            if (!result.Success)
            {
                if (result.ValidationErrors?.Any() == true)
                {
                    _errors.AddRange(result.ValidationErrors);
                }
                else if (!string.IsNullOrWhiteSpace(result.Error))
                {
                    _errors.Add(result.Error);
                }
                else
                {
                    _errors.Add("Registration failed.");
                }

                return;
            }

            await AuthService.LoginAsync(
                _email.Trim(),
                _password);

            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            _errors.Add(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errors.Add("Email is required.");
        }

        if (!string.IsNullOrWhiteSpace(_email)
            && !new System.ComponentModel.DataAnnotations.EmailAddressAttribute()
                .IsValid(_email))
        {
            _errors.Add("Invalid email address.");
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errors.Add("Password is required.");
        }

        if (string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _errors.Add("Password confirmation is required.");
        }

        if (!string.IsNullOrWhiteSpace(_password)
            && !string.IsNullOrWhiteSpace(_confirmPassword)
            && _password != _confirmPassword)
        {
            _errors.Add("Passwords do not match.");
        }
    }
}