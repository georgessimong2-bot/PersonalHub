@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudNavMenu>
    <MudNavLink Href="/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Login">
        Login
    </MudNavLink>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="/users"
                        Icon="@Icons.Material.Filled.People">
                Utilisateurs
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <MudNavLink Href="/index" Icon="@Icons.Material.Filled.Note">
        📝 Notes
    </MudNavLink>

    <MudNavLink Href="/mycode" Icon="@Icons.Material.Filled.Code">
        💻 MyCode
    </MudNavLink>
</MudNavMenu>

