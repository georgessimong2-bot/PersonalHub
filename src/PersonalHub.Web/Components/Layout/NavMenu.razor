@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudNavMenu>
    
    <AuthorizeView Roles="ADMIN">
        <Authorized>
            <MudNavLink Href="/users"
                        Icon="@Icons.Material.Filled.People">
                Utilisateurs
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

     <AuthorizeView Roles="USER, ADMIN">
        <Authorized>
            <MudNavLink Href="/notes" Icon="@Icons.Material.Filled.Note">
                Notes
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="USER, ADMIN">
        <Authorized>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="USER, ADMIN">
        <Authorized>
            <MudNavLink Href="/goals"
                        Icon="@Icons.Material.Filled.Flag">
                Goals
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="USER, ADMIN">
        <Authorized>
            <MudNavLink Href="/fundtypes"
                        Icon="@Icons.Material.Filled.CorporateFare">
                Fund types
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="USER, ADMIN">
        <Authorized>
            <MudNavLink Href="/funds"
                        Icon="@Icons.Material.Filled.CorporateFare">
                Funds
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

