@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<MudNavMenu>
    
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="/users"
                        Icon="@Icons.Material.Filled.People">
                Utilisateurs
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <MudNavLink Href="/index" Icon="@Icons.Material.Filled.Note">
        📝 Notes
    </MudNavLink>

    <AuthorizeView Roles="User, Admin">
        <Authorized>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

     <AuthorizeView Roles="User, Admin">
        <Authorized>
            <MudNavLink Href="/goals"
                        Icon="@Icons.Material.Filled.Flag">
                Goals
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

