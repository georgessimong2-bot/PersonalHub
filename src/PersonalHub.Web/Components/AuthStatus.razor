@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
<AuthorizeView>
    <Authorized Context="user">
        <MudChip T="string" Color="Color.Success">
            👤 @user.User.Identity?.Name
        </MudChip>
    </Authorized>

    <NotAuthorized>
        <MudChip T="string" Color="Color.Error">
            ⚠️ Not logged in
        </MudChip>
    </NotAuthorized>
</AuthorizeView>